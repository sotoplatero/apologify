---
import { ClientRouter } from "astro:transitions";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VercelAnalytics from '../components/VercelAnalytics.astro';

interface Props {
	title: string;
	description: string;
	schema?: Record<string, any> | Record<string, any>[];
	canonicalUrl?: string;
	ogImage?: string;
	noindex?: boolean;
}

const {
	title = 'Apology Letters',
	description = 'Create heartfelt apology letters with our easy-to-use generator. Mend relationships and express sincere regret effectively. Free templates and expert tips.',
	schema,
	canonicalUrl,
	ogImage,
	noindex = false
} = Astro.props;

const currentUrl = new URL(Astro.url.pathname, Astro.site);
// One URL form site-wide: no trailing slash (except the root), no query string.
const canonicalBase = new URL(canonicalUrl || currentUrl.href);
canonicalBase.search = '';
canonicalBase.pathname = canonicalBase.pathname.replace(/\/+$/, '') || '/';
const canonical = canonicalBase.href;
const defaultOgImage = new URL('/og-image.png', Astro.site).href;
const finalOgImage = ogImage || defaultOgImage;
---

<!doctype html>
<html lang="en" data-theme="apology">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#FAF7F1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<meta name="generator" content={Astro.generator} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonical} />

		<!-- Language and Alternates -->
		<meta name="language" content="en" />
		<link rel="alternate" hreflang="en" href={canonical} />

		<!-- Open Graph Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={currentUrl.href} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={finalOgImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="Apologify" />

		<!-- Twitter Card Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={finalOgImage} />

		<!-- Performance: Preconnect to external resources -->
		<link rel="preconnect" href="https://images.unsplash.com" />
		<link rel="dns-prefetch" href="https://images.unsplash.com" />

		<!-- Google Fonts: Spectral (display + reading) and Jost (UI); Dancing Script (signatures) and Anton (Keep Calm) serve the templates -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@300..700&family=Anton&family=Dancing+Script:wght@400;500;600;700&display=swap" rel="stylesheet" />

		<link rel="sitemap" href="/sitemap-index.xml" />
		<title>{title}</title>

		<!-- Analytics -->
		<script defer src="https://umami.volttus.com/script.js" data-website-id="cf312f64-f14b-41ba-bfa2-18e9a30f5382" data-domains="apologify.com"></script>

		<!-- Structured Data -->
		{schema && (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		)}

		<ClientRouter />
		<VercelAnalytics />
		<slot name="head" />
	</head>
	<body class="flex flex-col min-h-screen overflow-x-hidden bg-base-100 text-base-content font-serif">
		<slot />
	</body>
</html>
