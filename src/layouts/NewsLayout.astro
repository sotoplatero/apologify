---
// Apology News is Apologify's magazine: the site's paper, ink, red and fonts
// (Spectral + Jost, loaded by LayoutBase), set light and airy, with its own
// masthead and footer instead of the site Header/Footer.
import LayoutBase from './LayoutBase.astro';

interface Props {
  title: string;
  description?: string;
  schema?: Record<string, any> | Record<string, any>[];
  canonicalUrl?: string;
  ogImage?: string;
  /** The home page sets the wordmark as its h1 and runs it larger. */
  home?: boolean;
}

const { title, description = title, schema, canonicalUrl, ogImage, home = false } = Astro.props;
const Wordmark = home ? 'h1' : 'p';
---

<LayoutBase title={title} description={description} schema={schema} canonicalUrl={canonicalUrl} ogImage={ogImage}>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Apology News" href="/news/rss.xml" />
    <slot name="head" />
  </Fragment>

  <div class:list={['an', { 'an-home': home }]}>
    <header class="an-mast">
      <nav class="an-nav" aria-label="Apology News">
        <a href="/news#archive">Issues</a>
        <a href="/news#how-we-score">How we score</a>
        <a href="#subscribe">Subscribe</a>
      </nav>
      <Wordmark class="an-wordmark"><a href="/news">Apology News</a></Wordmark>
      <a class="an-parent" href="/">by <img class="an-logo" src="/favicon.svg" alt="" width="20" height="20" /> Apologify</a>
    </header>

    <main class="an-main">
      <slot />
    </main>

    <footer class="an-foot">
      <p class="an-foot-mark"><a href="/news">Apology News</a></p>
      <p class="an-foot-copy">The week’s public apologies, scored. Every Tuesday, published by <a href="/">Apologify</a>.</p>
      <nav class="an-foot-links" aria-label="More">
        <a href="/generator">Write your own apology</a>
        <a href="/research/why-people-apologize">Our apology study</a>
        <a href="/news/rss.xml">RSS</a>
      </nav>
    </footer>
  </div>
</LayoutBase>

<style is:global>
  body:has(.an) { background: #faf7f1; }

  .an {
    /* Apologify's palette (tailwind.config.mjs), one step lighter for reading. */
    --an-ink: #241f1a;
    --an-body: #3a332c;
    --an-paper: #faf7f1;
    --an-mute: #6b6157;
    --an-rule: #e0d8c8;
    --an-soft: #f2ede3;
    --an-accent: #c1272d;
    --an-display: 'Spectral', Georgia, serif;
    --an-sans: 'Jost', system-ui, sans-serif;
    --an-gutter: clamp(1rem, 4vw, 3.5rem);
    --an-ease: cubic-bezier(0.16, 1, 0.3, 1);

    min-height: 100vh;
    background: var(--an-paper);
    color: var(--an-ink);
    font-family: var(--an-display);
    font-optical-sizing: auto;
    font-variant-numeric: lining-nums;
    -webkit-font-smoothing: antialiased;
  }
  .an ::selection { background: var(--an-ink); color: var(--an-paper); }
  .an a { color: inherit; text-decoration: none; }
  .an :focus-visible { outline: 1px solid var(--an-ink); outline-offset: 4px; }
  .an img { color: transparent; }

  /* Small tracked capitals: the one UI voice. */
  .an-caps {
    font-family: var(--an-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Text links inside running copy. */
  .an-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    transition: text-decoration-color 0.2s;
  }
  .an-link:hover { text-decoration-color: var(--an-accent); }
</style>

<style>
  .an-mast {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem var(--an-gutter) 1.25rem;
    border-bottom: 1px solid var(--an-ink);
    margin: 0 var(--an-gutter);
    padding-left: 0;
    padding-right: 0;
  }
  .an-nav { display: flex; gap: 2.25rem; }
  .an-nav a,
  .an-parent {
    font-family: var(--an-sans);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }
  .an-nav a:hover,
  .an-parent:hover { opacity: 0.55; }
  .an-parent { justify-self: end; display: inline-flex; align-items: center; white-space: nowrap; color: var(--an-mute); }
  .an-logo { width: 1.25rem; height: 1.25rem; margin: 0 0.4em; }

  .an-wordmark {
    margin: 0;
    font-family: var(--an-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 3.2vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .an-home .an-wordmark { font-size: clamp(2.6rem, 7.5vw, 6rem); letter-spacing: -0.03em; }
  .an-home .an-mast { padding-top: 1.75rem; padding-bottom: 1.6rem; }

  .an-main { display: block; }

  .an-foot {
    margin: 7rem var(--an-gutter) 0;
    padding: 3rem 0 3.5rem;
    border-top: 1px solid var(--an-ink);
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem 3rem;
    align-items: baseline;
  }
  .an-foot-mark { margin: 0; font-size: 1.6rem; letter-spacing: -0.02em; }
  .an-foot-copy { margin: 0; font-family: var(--an-sans); font-size: 0.9rem; font-weight: 400; color: var(--an-mute); }
  .an-foot-copy a { color: var(--an-ink); text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  .an-foot-links { display: flex; gap: 1.75rem; }
  .an-foot-links a {
    font-family: var(--an-sans);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .an-foot-links a:hover { opacity: 0.55; }

  @media (max-width: 860px) {
    .an-mast { grid-template-columns: 1fr; justify-items: center; gap: 0.9rem; }
    .an-wordmark { order: -1; }
    .an-nav { gap: 1.4rem; }
    .an-parent { display: none; }
    .an-foot { grid-template-columns: 1fr; margin-top: 5rem; }
    .an-foot-links { flex-wrap: wrap; gap: 1rem 1.5rem; }
  }
</style>
