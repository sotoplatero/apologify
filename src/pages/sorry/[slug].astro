---
import LayoutBase from "../../layouts/LayoutBase.astro";
import { templateFor } from "../../components/templates/registry";
import { getApologyPageBySlug } from "../../lib/apologyPages";
import { isLikelySlug } from "../../lib/slug.js";
import { apologyHeading, apologyParagraphsHtml } from "../../lib/display.js";
import OwnerBar from "../../components/OwnerBar.svelte";
import EnvelopeReveal from "../../components/EnvelopeReveal.astro";
import qrcode from "qrcode-generator";

export const prerender = false;

const { slug } = Astro.params;
if (!slug || !isLikelySlug(slug)) return Astro.redirect("/404");
const page = await getApologyPageBySlug(slug);
if (!page) return Astro.redirect("/404");

// Preview (iframe) may override the template id so the drawer can hot-swap.
const preview = Astro.url.searchParams.get("preview") === "1";
const themeOverride = Astro.url.searchParams.get("theme");
const templateId = preview && themeOverride ? themeOverride : page.theme;

// Owner-only affordances (copy link, change design). Hidden in preview (iframe).
const user = Astro.locals.user;
const isOwner = !preview && !!(user && page.ownerId && user.id === page.ownerId);
const justPublished = Astro.url.searchParams.get("published") === "1";
const openSend = Astro.url.searchParams.get("send") === "1";

// QR for the owner's send panel (print it, tuck it into flowers…).
let qrSvg = "";
if (isOwner) {
  const qr = qrcode(0, "M");
  qr.addData(new URL("/sorry/" + page.slug, Astro.site).href);
  qr.make();
  qrSvg = qr.createSvgTag({ cellSize: 4, margin: 0, scalable: true } as any);
}

const Template = templateFor(templateId);

const data = {
  title: page.title,
  heading: apologyHeading(page.recipientName),
  paragraphs: apologyParagraphsHtml(page.message),
  recipientName: page.recipientName,
  senderName: page.senderName,
  slug: page.slug,
  acceptedAt: page.acceptedAt,
  preview,
};

const noindex = preview || page.visibility !== "public";
const metaTitle = `${page.title} — An Apology | Apologify`;
const description = `${page.title} — a sincere apology${page.recipientName ? " for " + page.recipientName : ""}. Made on apologify.com.`.slice(0, 160);
const canonicalUrl = new URL("/sorry/" + page.slug, Astro.site).href;
// Per-page link preview: their name + the title on a sealed envelope.
const ogImage = new URL(`/og/${page.slug}.png`, Astro.site).href;
const pageSchema = {
  "@context": "https://schema.org", "@type": "CreativeWork",
  headline: `${page.title} — Apology`, description, genre: page.tone,
  dateCreated: page.createdAt ? new Date(page.createdAt).toISOString() : undefined,
  author: { "@type": "Organization", name: "Apologify" },
  publisher: { "@type": "Organization", name: "Apologify", url: "https://apologify.com" },
};
---

<LayoutBase title={metaTitle} description={description} canonicalUrl={canonicalUrl} ogImage={ogImage} schema={[pageSchema]} noindex={noindex}>
  {isOwner && <OwnerBar client:load slug={page.slug} justPublished={justPublished} openSend={openSend} recipientName={page.recipientName} qrSvg={qrSvg} />}
  {!preview && !justPublished && <EnvelopeReveal slug={page.slug} recipientName={page.recipientName} senderName={page.senderName} />}
  <Template {...data} />
</LayoutBase>
