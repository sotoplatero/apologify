---
import Layout from "../layouts/Layout.astro";
import { listThemes } from "../lib/themes.js";
import study from "../data/apology-study.json";

// US-facing landing: Apologify positioned as the modern "sorry card"
// ("sorry card" ~1.6k/mo, "i'm sorry card" and "apology card" ~720/mo each in the US).
const themes = listThemes();
const featured = ["classic", "postcard", "velvet", "handwritten", "watercolor", "starry", "cute-duck", "editorial"]
  .map((id) => themes.find((t) => t.id === id))
  .filter(Boolean) as ReturnType<typeof listThemes>;
const hero = ["postcard", "classic", "velvet"];

const pct = (key: string) => study.byCategory.find((c) => c.key === key)?.pct ?? 0;
const wordsPct = Math.round((pct("hurtful_words") + pct("temper") + pct("disrespect")) * 10) / 10;

const title = "Sorry Card: Make a Free “I'm Sorry” Card Online — Digital Apology Card";
const description =
  `Make a sorry card in minutes: say what happened, pick one of ${themes.length} card designs, and send the link. They see their name and your seal, open it, and can answer “I forgive you.” Free.`;
const canonicalUrl = new URL("/sorry-card", Astro.site).href;

const faqs = [
  {
    q: "What is a digital sorry card?",
    a: "It's an apology card that arrives as a link instead of in the mail. Apologify turns what you want to say into a card-style page with its own design. When they tap the link, they see their name under your seal; one tap opens your apology.",
  },
  {
    q: "Is it free?",
    a: "Yes. Writing your apology and previewing every card design is free, with no signup. You sign in with Google only when you publish, so you can find and edit your card later.",
  },
  {
    q: "How do I send it?",
    a: "After you publish, you get a ready-to-send message for WhatsApp, Telegram, text message or your own email, plus a copy-link button. You can also post a teaser image to your story.",
  },
  {
    q: "Can I give it as a real card?",
    a: "Yes. Every card comes with a QR code you can print and tuck inside a paper card, a note or a bunch of flowers. Scanning it opens your card.",
  },
  {
    q: "Will I know if they opened it?",
    a: "Yes. Your dashboard shows whether the card has been opened, and if they answer “I forgive you” or “I need some time.” You can also get an email when it happens.",
  },
  {
    q: "Is an “I'm sorry” card the same as an apology card?",
    a: "Yes, people search for both. An I'm sorry card tends to be personal (a partner, a friend, family); an apology card can be more formal (a coworker, a boss, a client). Apologify does both: pick a tone when you write it and a design that fits.",
  },
  {
    q: "What should I write in a sorry card?",
    a: `Be specific. In our study of ${study.sample.analyzed} real apologies, ${wordsPct}% were about words — something hurtful, a lost temper, disrespect — yet many people couldn't name what they'd done. Say exactly what happened, how it affected them, and one thing you'll do differently. Apologify helps you write it.`,
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: canonicalUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];

const compare = [
  { label: "Arrives today", paper: false, ecard: true, us: true },
  { label: "Written about what actually happened", paper: false, ecard: false, us: true },
  { label: "Feels like opening a real card", paper: true, ecard: "Sometimes", us: true },
  { label: "They can answer “I forgive you”", paper: false, ecard: false, us: true },
  { label: "You know when it's opened", paper: false, ecard: "Sometimes", us: true },
  { label: "Can be printed as a real card", paper: true, ecard: false, us: "With a QR" },
  { label: "Free", paper: false, ecard: "Sometimes", us: true },
];

// What to write: short, specific lines by person (each opens the builder for them).
const messages = [
  { who: "Girlfriend", gen: "girlfriend", text: "I'm sorry I made fun of your idea in front of everyone. It wasn't funny, it was unkind, and you deserved better from me. Next time I'll listen first." },
  { who: "Boyfriend", gen: "boyfriend", text: "I'm sorry I went through your phone. I let my own worry turn into not trusting you, and that wasn't fair. If something's bothering me, I'll say it to you." },
  { who: "Wife", gen: "wife", text: "I'm sorry I worked through our anniversary dinner. I keep telling you that you come first, and that night I showed you the opposite. My phone stays in the car on Saturday." },
  { who: "Husband", gen: "husband", text: "I'm sorry I brought up your job in front of my parents. That was between us, and I made you feel small. From now on, that stays at home." },
  { who: "Friend", gen: "friend", text: "I'm sorry I skipped your birthday dinner without a word. You planned it for weeks and I left an empty chair. Let me take you out: my treat, your pick." },
  { who: "Mom", gen: "mother", text: "Mom, I'm sorry I snapped at you on the phone. You were only asking how I was, and I made you feel like a bother. Call me anytime. I'll pick up and listen." },
  { who: "Coworker", gen: "colleague", text: "I'm sorry I presented the report as mine on Monday. You did the hard part and I should have said so. I've told the team, and I'll credit you every time." },
  { who: "Boss", gen: "boss", text: "I'm sorry I missed the client deadline and didn't warn you. You found out from them, not from me. From now on you'll hear about a slip the day I see it coming." },
];

const steps = [
  ["Tell us what happened", "Who it's for and what you did, in your own words. Apologify writes a sincere apology about that exact moment — you can edit it."],
  ["Pick a card", "Tender, playful or formal: a handwritten letter, a postcard, a watercolor, a velvet evening card. Preview every one live."],
  ["Send it — and hear back", "Text it, WhatsApp it or print the QR into a real card. They open it and can tell you how they feel."],
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} schema={schema}>
  <div class="sc">
    <section class="sc-hero">
      <div class="sc-hero-copy">
        <h1>A sorry card they'll actually open.</h1>
        <p class="sc-lede">
          An “I'm sorry” card written about what actually happened. Pick a design, send the link: they open it,
          read your apology — and can answer <em>“I forgive you.”</em>
        </p>
        <div class="sc-ctas">
          <a href="/generator" class="sc-btn">Make my sorry card</a>
          <a href="/designs" class="ap-link sc-alt">See all {themes.length} designs</a>
        </div>
        <p class="caps sc-note">Free to make · no signup to start · send by text, WhatsApp or email</p>
      </div>
      <div class="sc-stack" aria-hidden="true">
        {hero.map((id, i) => (
          <img src={`/designs/${id}.jpg`} alt="" width="820" height="1040" class={`sc-card sc-card-${i}`} loading={i === 1 ? "eager" : "lazy"} />
        ))}
      </div>
    </section>

    <section class="sc-block">
      <h2 class="sc-h2">How it works</h2>
      <ol class="sc-steps">
        {steps.map(([h, p], i) => (
          <li>
            <span class="sc-n" aria-hidden="true">{i + 1}</span>
            <h3>{h}</h3>
            <p>{p}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="sc-block">
      <div class="sc-head">
        <h2 class="sc-h2">Sorry card designs</h2>
        <a href="/designs" class="ap-link sc-alt">All {themes.length} designs</a>
      </div>
      <div class="sc-grid">
        {featured.map((t) => (
          <a href={`/demo?theme=${t.id}`} class="sc-design">
            <img src={`/designs/${t.id}.jpg`} alt={`${t.label} sorry card design`} width="820" height="1040" loading="lazy" />
            <span>{t.label}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="sc-block" id="what-to-write">
      <div class="sc-head">
        <h2 class="sc-h2">What to write in an I'm sorry card</h2>
        <a href="/how-to-apologize" class="ap-link sc-alt">How to apologize, step by step</a>
      </div>
      <p class="sc-intro">
        Three lines are enough: what you did, how it landed, what changes now. Skip “if you were hurt” and
        anything after a “but.” A few examples to start from:
      </p>
      <div class="sc-msgs">
        {messages.map((m) => (
          <figure class="sc-msg">
            <figcaption class="caps">For your {m.who.toLowerCase()}</figcaption>
            <blockquote>{m.text}</blockquote>
            <a href={`/generator/${m.gen}`} class="ap-link sc-alt">Make a sorry card for your {m.who.toLowerCase()}</a>
          </figure>
        ))}
      </div>
    </section>

    <section class="sc-block">
      <h2 class="sc-h2">Better than a paper card or a generic e-card</h2>
      <div class="sc-table-wrap">
        <table class="sc-table">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              <th scope="col">Paper card</th>
              <th scope="col">Typical e-card</th>
              <th scope="col" class="sc-us">Apologify</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {[row.paper, row.ecard, row.us].map((v, i) => (
                  <td class={i === 2 ? "sc-us" : undefined}>
                    {v === true ? <span class="sc-yes">Yes</span> : v === false ? <span class="sc-no">No</span> : <span class="sc-some">{v}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sc-block sc-study">
      <p class="sc-num">{wordsPct}<span>%</span></p>
      <div>
        <h2 class="sc-h2">What a sorry card should really say</h2>
        <p>
          We analyzed {study.sample.analyzed} real apologies. {wordsPct}% were about words — something hurtful,
          a lost temper, disrespect. Forgetting a birthday? Only {pct("forgot_date")}%. The apologies that land
          name the exact moment.
        </p>
        <a href="/research/why-people-apologize" class="ap-link sc-alt">Read the study</a>
      </div>
    </section>

    <section class="sc-block sc-faq">
      <h2 class="sc-h2">Sorry card questions</h2>
      <div>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="sc-final">
      <h2>Say sorry the way you mean it.</h2>
      <p>It takes about two minutes. They'll remember it longer.</p>
      <a href="/generator" class="sc-btn">Make my sorry card</a>
    </section>
  </div>
</Layout>

<style>
  .sc { color: var(--ap-ink); }

  /* Hero */
  .sc-hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1.25rem, 3vw, 3rem);
    align-items: center;
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
  }
  .sc-hero-copy { grid-column: 1 / span 6; }
  .sc-hero h1 {
    margin: 0;
    font-weight: 300;
    font-size: clamp(2.75rem, 6.2vw, 5.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .sc-lede { margin: 1.75rem 0 0; max-width: 32rem; font-family: 'Spectral', Georgia, serif; font-size: 1.3rem; line-height: 1.55; color: var(--ap-body); text-wrap: pretty; }
  .sc-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem; margin-top: 2.25rem; }
  .sc-btn {
    display: inline-block;
    padding: 1.05rem 1.9rem;
    background: var(--ap-red);
    color: #faf7f1;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: background-color 0.25s;
  }
  .sc-btn:hover { background: var(--ap-ink); }
  .sc-alt { font-family: 'Jost', system-ui, sans-serif; font-size: 0.98rem; color: var(--ap-ink); }
  .sc-note { margin: 2rem 0 0; color: var(--ap-mute); }

  /* Three real cards, laid on the table and fanned open once on arrival. */
  .sc-stack { grid-column: 7 / span 6; position: relative; height: clamp(22rem, 36vw, 30rem); }
  .sc-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(10rem, 17vw, 14.5rem);
    height: auto;
    box-shadow: 0 30px 50px -28px rgba(36, 31, 26, 0.5), 0 1px 3px rgba(36, 31, 26, 0.12);
    animation: sc-fan 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  .sc-card-0 { --to: translate(-118%, -46%); }
  .sc-card-1 { --to: translate(-50%, -54%); z-index: 2; }
  .sc-card-2 { --to: translate(18%, -46%); }
  .sc-card { transform: var(--to); }
  @keyframes sc-fan { from { transform: translate(-50%, -50%); } }

  /* Sections */
  .sc-block { margin-top: clamp(5rem, 9vw, 7rem); padding-top: 1.5rem; border-top: 1px solid var(--ap-ink); }
  .sc-h2 { margin: 0 0 2.25rem; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.05; letter-spacing: -0.025em; text-wrap: balance; }
  .sc-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }

  .sc-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .sc-steps li { padding: 0 clamp(1.25rem, 3vw, 2.5rem); border-left: 1px solid var(--ap-rule); }
  .sc-steps li:first-child { padding-left: 0; border-left: 0; }
  .sc-n { font-family: 'Spectral', Georgia, serif; font-weight: 300; font-size: 3.25rem; line-height: 1; color: var(--ap-red); }
  .sc-steps h3 { margin: 1.25rem 0 0.6rem; font-size: 1.55rem; line-height: 1.2; }
  .sc-steps p { margin: 0; font-size: 0.98rem; line-height: 1.65; color: var(--ap-body); max-width: 32ch; }

  .sc-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 3rem clamp(1.25rem, 3vw, 3rem); }
  .sc-design { display: block; }
  .sc-design img { width: 100%; height: auto; display: block; background: var(--ap-soft); transition: opacity 0.4s var(--ap-ease); }
  .sc-design:hover img { opacity: 0.85; }
  .sc-design span { display: block; margin-top: 1rem; font-family: 'Spectral', Georgia, serif; font-size: 1.35rem; letter-spacing: -0.01em; }
  .sc-design:hover span { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }

  #what-to-write .sc-h2 { margin-bottom: 0.75rem; }
  .sc-intro { margin: 1rem 0 2.5rem; max-width: 40rem; font-family: 'Spectral', Georgia, serif; font-size: 1.2rem; line-height: 1.6; color: var(--ap-body); }
  .sc-msgs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(2rem, 5vw, 5rem); }
  .sc-msg { margin: 0; padding: 1.75rem 0 2rem; border-top: 1px solid var(--ap-rule); display: flex; flex-direction: column; }
  .sc-msg figcaption { color: var(--ap-mute); }
  .sc-msg blockquote { margin: 0.9rem 0 1.25rem; font-family: 'Spectral', Georgia, serif; font-size: 1.22rem; line-height: 1.55; color: var(--ap-ink); text-wrap: pretty; flex: 1; }
  .sc-msg .sc-alt { font-size: 0.92rem; align-self: flex-start; }

  .sc-table-wrap { overflow-x: auto; }
  .sc-table { width: 100%; min-width: 34rem; border-collapse: collapse; font-size: 0.98rem; }
  .sc-table th, .sc-table td { padding: 1rem 1rem 1rem 0; text-align: left; border-bottom: 1px solid var(--ap-rule); }
  .sc-table thead th { font-size: 0.68rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ap-mute); border-bottom-color: var(--ap-ink); }
  .sc-table thead .sc-us { color: var(--ap-red); }
  .sc-table tbody th { font-family: 'Spectral', Georgia, serif; font-weight: 400; font-size: 1.12rem; }
  .sc-yes { color: var(--ap-ink); font-weight: 500; }
  .sc-no { color: #a29785; }
  .sc-some { color: var(--ap-mute); }
  .sc-table td.sc-us .sc-yes { color: var(--ap-red); }

  .sc-study { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2rem clamp(2rem, 5vw, 5rem); align-items: start; }
  .sc-study .sc-num { margin: 0; font-family: 'Spectral', Georgia, serif; font-weight: 300; font-size: clamp(5rem, 13vw, 10rem); line-height: 0.85; letter-spacing: -0.04em; color: var(--ap-red); font-variant-numeric: lining-nums; }
  .sc-study .sc-num span { font-size: 0.45em; vertical-align: top; margin-left: 0.05em; }
  .sc-study .sc-h2 { margin-bottom: 1.25rem; }
  .sc-study p { margin: 0 0 1.5rem; max-width: 38rem; font-family: 'Spectral', Georgia, serif; font-size: 1.2rem; line-height: 1.6; color: var(--ap-body); }

  .sc-faq { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2rem clamp(2rem, 5vw, 5rem); }
  .sc-faq details { border-top: 1px solid var(--ap-rule); }
  .sc-faq details:last-child { border-bottom: 1px solid var(--ap-rule); }
  .sc-faq summary {
    position: relative;
    list-style: none;
    padding: 1.25rem 2.5rem 1.25rem 0;
    font-family: 'Spectral', Georgia, serif;
    font-size: 1.3rem;
    cursor: pointer;
  }
  .sc-faq summary::-webkit-details-marker { display: none; }
  .sc-faq summary::before,
  .sc-faq summary::after { content: ''; position: absolute; right: 0.25rem; top: 50%; width: 0.9rem; height: 1px; background: var(--ap-ink); transition: transform 0.3s var(--ap-ease); }
  .sc-faq summary::after { transform: rotate(90deg); }
  .sc-faq details[open] summary::after { transform: rotate(0deg); }
  .sc-faq details p { margin: 0 0 1.5rem; max-width: 62ch; font-size: 0.98rem; line-height: 1.7; color: var(--ap-body); }

  .sc-final { margin: clamp(5rem, 10vw, 8rem) auto 0; max-width: 46rem; padding-top: clamp(3rem, 6vw, 4.5rem); border-top: 1px solid var(--ap-rule); text-align: center; }
  .sc-final h2 { margin: 0; font-size: clamp(2.2rem, 5vw, 3.75rem); line-height: 1.04; letter-spacing: -0.025em; }
  .sc-final p { margin: 1.25rem 0 2.25rem; font-family: 'Spectral', Georgia, serif; font-size: 1.2rem; color: var(--ap-body); }

  @media (max-width: 900px) {
    .sc-hero { display: block; padding-top: 2.5rem; }
    .sc-stack { height: 19rem; margin-top: 2.5rem; }
    .sc-card { width: 9.5rem; }
    .sc-steps, .sc-study, .sc-faq, .sc-msgs { grid-template-columns: 1fr; }
    .sc-steps { gap: 2.5rem; }
    .sc-steps li { padding: 0; border-left: 0; }
    .sc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1rem; }
    .sc-design span { font-size: 1.15rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc-card { animation: none; }
  }
</style>
