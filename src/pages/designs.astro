---
import Layout from "../layouts/Layout.astro";
import { listThemes } from "../lib/themes.js";

const themes = listThemes();

const title = `Apology Page Designs — ${themes.length} Templates | Apologify`;
const description =
  "Browse every Apologify design — from a handwritten letter or a postcard to a velvet evening card, a magazine page or a front-page correction. Pick one and turn your apology into a shareable page, free.";

const canonicalUrl = new URL("/designs", Astro.site).href;
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Apology Page Designs",
  description,
  url: canonicalUrl,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: themes.length,
    itemListElement: themes.map((t, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${t.label} apology page design`,
    })),
  },
};
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} schema={[collectionSchema]}>
  <div class="py-12 md:py-16">
    <header class="text-center max-w-2xl mx-auto mb-14">
      <h1 class="font-display text-4xl md:text-6xl text-base-content mb-5" style="text-wrap: balance;">
        A design for every apology
      </h1>
      <p class="text-lg text-base-content/75 mb-8 font-sans">
        {themes.length} distinct looks — tender or formal, playful or grave. Tap any one to see it live, then make it yours.
      </p>
      <a href="/generator" class="btn btn-primary btn-lg">Make my apology page</a>
    </header>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10 pt-8 border-t border-base-content">
      {themes.map((t) => (
        <a
          href={`/demo?theme=${t.id}`}
          class="group block"
        >
          <div class="relative overflow-hidden bg-base-200">
            <img
              src={`/designs/${t.id}.jpg`}
              alt={`${t.label} apology page design`}
              loading="lazy"
              width="820"
              height="1040"
              class="w-full h-auto transition-opacity duration-500 group-hover:opacity-85"
            />
            {t.premium && (
              <span class="absolute top-2 right-2 text-[10px] font-bold bg-warning text-warning-content px-1.5 py-0.5 rounded shadow">PRO</span>
            )}
          </div>
          <p class="mt-3 font-display text-xl text-base-content group-hover:underline decoration-1 underline-offset-4">{t.label}</p>
        </a>
      ))}
    </div>

    <div class="text-center mt-14">
      <a href="/generator" class="btn btn-primary btn-lg">Make my apology page</a>
      <p class="caps text-base-content/70 mt-4">Free to create · pick any design · share with a link</p>
    </div>
  </div>
</Layout>
