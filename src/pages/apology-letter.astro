---
import Layout from "../layouts/Layout.astro";
import study from "../data/apology-study.json";

// US pillar page for the "apology letter" cluster: apology letter (4.4k/mo),
// write an apology letter (4.4k), how to write an apology letter (1.6k),
// apology letter format / template (720 each), sorry letter (590).
// The homepage ranked ~#20–28 for these with a page about something else.
const pct = (key: string) => study.byCategory.find((c) => c.key === key)?.pct ?? 0;
const wordsPct = Math.round((pct("hurtful_words") + pct("temper") + pct("disrespect")) * 10) / 10;

const title = "How to Write an Apology Letter (Format, Template & Examples)";
const description =
  "How to write an apology letter that actually lands: the 5-part format, a fill-in template, real examples for a partner, a friend and a teacher, and what to avoid — based on 845 real apologies.";
const canonicalUrl = new URL("/apology-letter", Astro.site).href;

const parts = [
  {
    h: "Say sorry, plainly",
    p: "Open with the apology itself, not with context. “I'm sorry” or “I apologize” in the first line tells them this letter is about them, not about you.",
    eg: "I'm sorry for what I said to you on Saturday.",
  },
  {
    h: "Name exactly what you did",
    p: `This is the part most apologies skip. In our study, ${study.vaguePct}% of people couldn't name the act at all — “sorry for the misunderstanding.” Say the specific thing, in the words they'd use.`,
    eg: "In front of your sister, I said you never finish anything. That was cruel, and it wasn't true.",
  },
  {
    h: "Show you understand the impact",
    p: "Describe what it did to them, without arguing about whether it should have. This is what makes someone feel heard.",
    eg: "You'd been nervous about that dinner all week, and I made you feel small at the one moment you needed me on your side.",
  },
  {
    h: "Take responsibility — no “but”",
    p: "Explanations are fine; excuses aren't. If a sentence starts with “but” or “if you felt,” cut it.",
    eg: "I was stressed about work, but that's mine to deal with. It was never yours to absorb.",
  },
  {
    h: "Say what you'll do differently",
    p: "A concrete change or repair, small enough to keep. Then let them respond in their own time — don't demand forgiveness.",
    eg: "Next time I'm on edge, I'll say so instead of taking it out on you. Take whatever time you need.",
  },
];

const template = `Dear [Name],

I'm sorry for [what you did — one specific sentence].

[When and where it happened, briefly.] I know it [how it affected them: hurt you, embarrassed you, made you feel ignored].

There's no excuse for it. [Optional: one honest line of context — without “but.”]

From now on, I'm going to [one concrete change or repair].

I understand if you need time. Whenever you're ready, I'd like to talk.

[Your name]`;

const examples = [
  {
    to: "To a partner",
    situation: "Went silent for two days after an argument",
    body: [
      "Dear Sam,",
      "I'm sorry I went silent on you after our argument on Thursday. I saw every one of your messages and chose not to answer for two days.",
      "I know that left you wondering whether we were okay, and that waiting felt worse than the argument itself. Going quiet felt like cooling off to me; to you it felt like being shut out.",
      "From now on, if I need space, I'll say “I need a few hours, I'm not going anywhere” instead of disappearing.",
      "I love you, and I'm here whenever you want to talk.",
      "Alex",
    ],
    more: { href: "/examples/romantic", label: "More apology letters to a partner" },
  },
  {
    to: "To a friend",
    situation: "Missed their birthday dinner without telling them",
    body: [
      "Hi Jordan,",
      "I'm sorry I didn't show up to your birthday dinner on Friday — and that I didn't even text to say so. You found out I wasn't coming from an empty chair.",
      "You'd booked the table for everyone, and I made a night that was supposed to be about you about my absence. That's not what a friend does.",
      "I'd like to take you out this week, just us, my treat — whenever works for you.",
      "Maya",
    ],
    more: { href: "/examples/friend", label: "More apology letters to a friend" },
  },
  {
    to: "To a teacher",
    situation: "Disrupted class and talked back",
    body: [
      "Dear Ms. Carter,",
      "I apologize for my behavior in class on Tuesday. I kept talking while you were explaining the assignment, and when you asked me to stop, I answered back in a rude way.",
      "That interrupted the lesson for everyone and was disrespectful to you in front of the class.",
      "From now on I'll stay focused during instruction, and if I disagree with something, I'll ask to speak with you after class.",
      "Sincerely,",
      "Daniel Reyes",
    ],
    more: { href: "/examples/teacher", label: "More apology letters to a teacher" },
  },
];

const avoid = [
  ["“I'm sorry if you were hurt.”", "“If” puts the hurt in question. Say “I'm sorry I hurt you.”"],
  ["“I'm sorry, but…”", "Everything after “but” erases what came before it."],
  ["“Sorry for the misunderstanding.”", "It names nothing. Say what actually happened."],
  ["Three paragraphs about your week", "Context is one line. The letter is about them."],
  ["“Please forgive me.”", "Asking is fine; demanding a reply isn't. Leave them room."],
  ["Bringing up what they did", "That's a different conversation. Have it another day."],
];

const recipientLinks = [
  ["girlfriend", "Girlfriend"],
  ["boyfriend", "Boyfriend"],
  ["wife", "Wife"],
  ["husband", "Husband"],
  ["friend", "Friend"],
  ["mother", "Mom"],
  ["father", "Dad"],
  ["teacher", "Teacher"],
  ["boss", "Boss"],
  ["colleague", "Coworker"],
  ["client", "Client"],
  ["public", "Customers"],
];

const faqs = [
  {
    q: "How do you start an apology letter?",
    a: "Start with the apology itself — “I'm sorry for…” followed by the specific thing you did. Skip warm-ups like “I've been thinking a lot lately.” The first sentence should tell them exactly what this letter is about.",
  },
  {
    q: "How long should an apology letter be?",
    a: "Usually 100–250 words: long enough to name what happened, how it affected them and what you'll change; short enough that it doesn't turn into a story about you. A formal apology at work can be even shorter.",
  },
  {
    q: "How do you end an apology letter?",
    a: "End with what you'll do differently and an open door — “I'd like to talk whenever you're ready.” Don't end by asking them to forgive you right away. For formal letters, close with “Sincerely” and your full name.",
  },
  {
    q: "What is the format of an apology letter?",
    a: "Greeting; a direct apology; the specific thing you did; its impact on them; responsibility without excuses; what you'll do differently; a closing and your name. For a formal letter, add the date and use a formal greeting (“Dear Mr. Lee”).",
  },
  {
    q: "Should an apology letter be handwritten?",
    a: "A handwritten letter shows effort, but what matters most is that it's specific and honest. If they're far away or you need it to arrive today, a digital letter they can open privately works — Apologify turns yours into a page with its own design that you send as a link.",
  },
  {
    q: "What do people apologize for most?",
    a: `In our analysis of ${study.sample.analyzed} real apologies, ${wordsPct}% were about words — saying something hurtful, losing your temper or being disrespectful. Going silent or ignoring messages was ${pct("silence")}%. Forgetting a birthday or anniversary was only ${pct("forgot_date")}%.`,
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "How to Write an Apology Letter",
    description,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    datePublished: "2026-10-26",
    dateModified: "2026-10-26",
    author: { "@type": "Organization", name: "Apologify", url: "https://apologify.com" },
    publisher: { "@type": "Organization", name: "Apologify", logo: { "@type": "ImageObject", url: "https://apologify.com/seal.svg" } },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} schema={schema}>
  <div class="al">
    <header class="al-hero">
      <h1>How to write an apology letter</h1>
      <p class="al-lede">
        A good apology letter does three things: it names exactly what you did, shows you understand how it
        landed, and says what will change. Here's the format, a template you can fill in, and real examples —
        built on what we learned from {study.sample.analyzed} real apologies.
      </p>
      <nav class="al-toc caps" aria-label="On this page">
        <a href="#format">Format</a>
        <a href="#template">Template</a>
        <a href="#examples">Examples</a>
        <a href="#avoid">What to avoid</a>
        <a href="#faq">FAQ</a>
      </nav>
    </header>

    <section class="al-block" id="format">
      <h2 class="al-h2">The apology letter format, in five parts</h2>
      <ol class="al-parts">
        {parts.map((part, i) => (
          <li>
            <span class="al-n" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{part.h}</h3>
              <p>{part.p}</p>
              <p class="al-eg">“{part.eg}”</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="al-block al-study">
      <p class="al-num">{wordsPct}<span>%</span></p>
      <div>
        <h2 class="al-h2">Most apologies are about words, not deeds</h2>
        <p>
          We classified {study.sample.analyzed} real apologies by what people were sorry for. {wordsPct}% came down to
          something said — a hurtful remark, a lost temper, disrespect. {study.digital.pct}% involved a phone: ignored
          texts, going silent, blocking. And {study.vaguePct}% never named the act at all.
        </p>
        <p>The lesson for your letter: quote the moment. The more exactly you name it, the more it reads as real.</p>
        <a href="/research/why-people-apologize" class="ap-link al-alt">Read the full study</a>
      </div>
    </section>

    <section class="al-block" id="template">
      <div class="al-head">
        <h2 class="al-h2">Apology letter template</h2>
        <button type="button" class="ap-link al-alt al-copy" data-copy>Copy template</button>
      </div>
      <p class="al-intro">Replace everything in brackets. If a bracket feels hard to fill, that's the part the letter needs most.</p>
      <pre class="al-template" id="al-template">{template}</pre>
    </section>

    <section class="al-block" id="examples">
      <h2 class="al-h2">Apology letter examples</h2>
      <div class="al-examples">
        {examples.map((ex) => (
          <article class="al-ex">
            <p class="caps al-ex-to">{ex.to}</p>
            <p class="al-ex-sit">{ex.situation}</p>
            <div class="al-letter">
              {ex.body.map((line) => <p>{line}</p>)}
            </div>
            <a href={ex.more.href} class="ap-link al-alt">{ex.more.label}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="al-block" id="avoid">
      <h2 class="al-h2">What not to write</h2>
      <dl class="al-avoid">
        {avoid.map(([bad, why]) => (
          <div>
            <dt>{bad}</dt>
            <dd>{why}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="al-block">
      <div class="al-head">
        <h2 class="al-h2">Apology letters by who you're writing to</h2>
        <a href="/examples" class="ap-link al-alt">All sample letters</a>
      </div>
      <ul class="al-recipients">
        {recipientLinks.map(([id, label]) => (
          <li><a href={`/examples/${id}`}>Apology letter to {id === "public" ? "customers" : `a ${label.toLowerCase()}`}</a></li>
        ))}
      </ul>
    </section>

    <section class="al-block al-tool">
      <div>
        <h2 class="al-h2">Rather not start from a blank page?</h2>
        <p>
          Tell Apologify who it's for and what happened. It writes a sincere apology about that exact moment —
          you edit it — and turns it into a letter they open from a sealed envelope, with a way to answer
          “I forgive you.”
        </p>
        <a href="/generator" class="al-btn">Write my apology letter</a>
        <p class="caps al-note">Free · no signup to start</p>
      </div>
      <img src="/designs/classic.jpg" alt="An apology letter made with Apologify, in the Letter design" width="820" height="1040" loading="lazy" />
    </section>

    <section class="al-block al-faq" id="faq">
      <h2 class="al-h2">Apology letter questions</h2>
      <div>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  document.querySelector<HTMLButtonElement>("[data-copy]")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const text = document.getElementById("al-template")?.textContent ?? "";
    try {
      await navigator.clipboard.writeText(text);
      btn.textContent = "Copied";
      setTimeout(() => (btn.textContent = "Copy template"), 2000);
    } catch {
      btn.textContent = "Select the text to copy";
    }
  });
</script>

<style>
  .al { color: var(--ap-ink); }

  .al-hero { padding: clamp(3rem, 7vw, 6rem) 0 0; max-width: 52rem; }
  .al-hero h1 {
    margin: 0;
    font-weight: 300;
    font-size: clamp(2.75rem, 6.2vw, 5.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .al-lede { margin: 1.75rem 0 0; max-width: 40rem; font-family: 'Spectral', Georgia, serif; font-size: 1.3rem; line-height: 1.55; color: var(--ap-body); text-wrap: pretty; }
  .al-toc { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; margin-top: 2.25rem; }
  .al-toc a { color: var(--ap-ink); }
  .al-toc a:hover { color: var(--ap-red); }

  .al-block { margin-top: clamp(4.5rem, 8vw, 6.5rem); padding-top: 1.5rem; border-top: 1px solid var(--ap-ink); scroll-margin-top: 5rem; }
  .al-h2 { margin: 0 0 2.25rem; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.05; letter-spacing: -0.025em; text-wrap: balance; }
  .al-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .al-alt { font-family: 'Jost', system-ui, sans-serif; font-size: 0.98rem; color: var(--ap-ink); }
  .al-intro { margin: -1rem 0 1.75rem; max-width: 40rem; color: var(--ap-body); line-height: 1.65; }

  .al-parts { list-style: none; margin: 0; padding: 0; }
  .al-parts li { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 1rem; padding: 1.75rem 0; border-top: 1px solid var(--ap-rule); }
  .al-parts li:first-child { border-top: 0; padding-top: 0; }
  .al-n { font-family: 'Spectral', Georgia, serif; font-weight: 300; font-size: 3rem; line-height: 1; color: var(--ap-red); }
  .al-parts h3 { margin: 0.2rem 0 0.6rem; font-size: 1.55rem; line-height: 1.2; }
  .al-parts p { margin: 0; max-width: 42rem; font-size: 1rem; line-height: 1.7; color: var(--ap-body); }
  .al-parts .al-eg { margin-top: 0.85rem; font-family: 'Spectral', Georgia, serif; font-style: italic; font-size: 1.15rem; color: var(--ap-ink); }

  .al-study { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2rem clamp(2rem, 5vw, 5rem); align-items: start; }
  .al-study .al-num { margin: 0; font-family: 'Spectral', Georgia, serif; font-weight: 300; font-size: clamp(5rem, 13vw, 10rem); line-height: 0.85; letter-spacing: -0.04em; color: var(--ap-red); font-variant-numeric: lining-nums; }
  .al-study .al-num span { font-size: 0.45em; vertical-align: top; margin-left: 0.05em; }
  .al-study .al-h2 { margin-bottom: 1.25rem; }
  .al-study p { margin: 0 0 1.25rem; max-width: 38rem; font-family: 'Spectral', Georgia, serif; font-size: 1.2rem; line-height: 1.6; color: var(--ap-body); }

  .al-copy { background: none; border: 0; padding: 0; cursor: pointer; }
  .al-template {
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    background: var(--ap-soft);
    border-left: 2px solid var(--ap-red);
    font-family: 'Spectral', Georgia, serif;
    font-size: 1.15rem;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--ap-ink);
  }

  .al-examples { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem clamp(1.5rem, 3vw, 3rem); }
  .al-ex-to { margin: 0; color: var(--ap-red); }
  .al-ex-sit { margin: 0.5rem 0 1.25rem; font-family: 'Spectral', Georgia, serif; font-size: 1.3rem; line-height: 1.25; }
  .al-letter { padding: 1.5rem 0 1.5rem 1.25rem; border-left: 1px solid var(--ap-rule); margin-bottom: 1.25rem; }
  .al-letter p { margin: 0 0 0.9rem; font-family: 'Spectral', Georgia, serif; font-size: 1.05rem; line-height: 1.6; color: var(--ap-body); }
  .al-letter p:last-child { margin-bottom: 0; }

  .al-avoid { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2rem, 5vw, 4rem); }
  .al-avoid div { padding: 1.25rem 0; border-top: 1px solid var(--ap-rule); }
  .al-avoid dt { font-family: 'Spectral', Georgia, serif; font-size: 1.25rem; text-decoration: line-through; text-decoration-color: var(--ap-red); text-decoration-thickness: 1px; }
  .al-avoid dd { margin: 0.4rem 0 0; color: var(--ap-body); line-height: 1.6; }

  .al-recipients { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: clamp(1.5rem, 4vw, 3rem); }
  .al-recipients li { border-top: 1px solid var(--ap-rule); }
  .al-recipients a { display: block; padding: 1rem 0; font-family: 'Spectral', Georgia, serif; font-size: 1.15rem; color: var(--ap-ink); }
  .al-recipients a:hover { color: var(--ap-red); }

  .al-tool { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 2rem clamp(2rem, 6vw, 6rem); align-items: center; }
  .al-tool p { max-width: 36rem; font-family: 'Spectral', Georgia, serif; font-size: 1.2rem; line-height: 1.6; color: var(--ap-body); margin: 0 0 2rem; }
  .al-tool img { width: 100%; height: auto; box-shadow: 0 30px 50px -28px rgba(36, 31, 26, 0.5), 0 1px 3px rgba(36, 31, 26, 0.12); }
  .al-btn {
    display: inline-block;
    padding: 1.05rem 1.9rem;
    background: var(--ap-red);
    color: #faf7f1;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: background-color 0.25s;
  }
  .al-btn:hover { background: var(--ap-ink); }
  .al-tool .al-note { margin: 1.25rem 0 0; font-family: 'Jost', system-ui, sans-serif; font-size: 0.68rem; color: var(--ap-mute); }

  .al-faq { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2rem clamp(2rem, 5vw, 5rem); }
  .al-faq details { border-top: 1px solid var(--ap-rule); }
  .al-faq details:last-child { border-bottom: 1px solid var(--ap-rule); }
  .al-faq summary {
    position: relative;
    list-style: none;
    padding: 1.25rem 2.5rem 1.25rem 0;
    font-family: 'Spectral', Georgia, serif;
    font-size: 1.3rem;
    cursor: pointer;
  }
  .al-faq summary::-webkit-details-marker { display: none; }
  .al-faq summary::before,
  .al-faq summary::after { content: ''; position: absolute; right: 0.25rem; top: 50%; width: 0.9rem; height: 1px; background: var(--ap-ink); transition: transform 0.3s var(--ap-ease); }
  .al-faq summary::after { transform: rotate(90deg); }
  .al-faq details[open] summary::after { transform: rotate(0deg); }
  .al-faq details p { margin: 0 0 1.5rem; max-width: 62ch; font-size: 0.98rem; line-height: 1.7; color: var(--ap-body); }

  @media (max-width: 900px) {
    .al-study, .al-faq, .al-tool, .al-examples, .al-avoid { grid-template-columns: 1fr; }
    .al-recipients { grid-template-columns: 1fr 1fr; }
    .al-parts li { grid-template-columns: 2.75rem minmax(0, 1fr); }
    .al-n { font-size: 2.25rem; }
    .al-tool img { max-width: 16rem; }
  }
  @media (max-width: 480px) {
    .al-recipients { grid-template-columns: 1fr; }
  }
</style>
