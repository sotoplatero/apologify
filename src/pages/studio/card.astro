---
// Gated internal render page for Social Studio. Renders any design template
// with content supplied via query params, but ONLY when the request carries a
// valid `x-studio-key` header (== STUDIO_API_KEY). Without the header it 404s,
// so it is never a public, browser-navigable "apology page". It is meant to be
// consumed server-side by POST /api/social-card, which inlines its CSS and
// returns self-contained HTML to the standalone studio tool.
import LayoutBase from "../../layouts/LayoutBase.astro";
import { templateFor } from "../../components/templates/registry";
import { apologyHeading, apologyParagraphsHtml } from "../../lib/display.js";

export const prerender = false;

const provided = Astro.request.headers.get("x-studio-key");
const expected = import.meta.env.STUDIO_API_KEY || process.env.STUDIO_API_KEY;
if (!expected || provided !== expected) {
  return new Response("Not found", { status: 404 });
}


const q = Astro.url.searchParams;
const themeId = q.get("theme") ?? "classic";
const Template = templateFor(themeId);

const to = q.get("to") ?? "";
const message = q.get("message") ?? "";
const data = {
  title: q.get("title") ?? "",
  heading: apologyHeading(to),
  paragraphs: apologyParagraphsHtml(message),
  recipientName: to,
  senderName: q.get("sender") ?? "",
  slug: "studio",
  acceptedAt: null,
  // Render the REAL page view — including the live Like/Share buttons — so the
  // marketing screenshot matches what a recipient actually sees. The island is
  // never hydrated in the screenshot path, so no like is ever recorded.
  preview: false,
};
---

<LayoutBase title="Studio card" description="Social Studio render" noindex={true}>
  <Template {...data} />
</LayoutBase>
