---
import Layout from '../../../layouts/Layout.astro';
import { normalizeRecipient, recipientLabel } from '../../../lib/recipients.js';
import LetterCard from '../../../components/LetterCard.astro';
import { getLettersByRecipient } from '../../../lib/db';
import { recipientGuide } from '../../../lib/recipientGuides';
import RecipientGuide from '../../../components/RecipientGuide.astro';

export const prerender = false;

const { recipient } = Astro.params;

if (!recipient) {
  return Astro.redirect('/examples');
}

// Legacy free-text recipients ("Boyfriend ", "gf") 301 to their canonical id;
// anything unrecognizable or empty is a real 404 (was a soft 404).
const canonicalRecipient = normalizeRecipient(recipient);
if (canonicalRecipient && canonicalRecipient !== recipient) {
  return Astro.redirect(`/examples/${canonicalRecipient}`, 301);
}

const finalRecipientLabel = recipientLabel(recipient);

const allLetters = canonicalRecipient ? await getLettersByRecipient(recipient) : [];
if (allLetters.length === 0) {
  return Astro.rewrite('/404');
}

const guide = recipientGuide(recipient);
const fill = (s: string) => s.replace('{n}', String(allLetters.length));

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://apologify.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Examples",
      "item": "https://apologify.com/examples"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": finalRecipientLabel
    }
  ]
};

// Canonical URL
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Collection page schema
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `Apology Letters for ${finalRecipientLabel}`,
  "description": `Browse ${allLetters.length} example apology letters specifically for ${finalRecipientLabel?.toLowerCase()}`,
  "url": canonicalUrl,
  "numberOfItems": allLetters.length,
  "author": {
    "@type": "Organization",
    "name": "Apologify"
  }
};

const faqSchema = guide && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: guide.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Layout
  title={guide ? fill(guide.title) : `Apology Letter to ${finalRecipientLabel}: ${allLetters.length} Real Examples`}
  description={guide ? fill(guide.description) : `Read ${allLetters.length} real apology letters to a ${finalRecipientLabel.toLowerCase()} for every situation — copy one, or turn yours into a shareable sorry page.`}
  canonicalUrl={canonicalUrl}
  schema={guide ? [breadcrumbSchema, collectionSchema, faqSchema] : [breadcrumbSchema, collectionSchema]}
>
  <main class="container mx-auto px-4 sm:px-6 py-12">
    {guide ? (
      <RecipientGuide guide={guide} recipient={recipient} count={allLetters.length} />
    ) : (
      <div class="text-center space-y-4 mb-12">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-base-content leading-tight tracking-tight">Apology Letters for {finalRecipientLabel}</h1>
        <p class="text-xl text-base-content/70">Browse apology letters specifically for {finalRecipientLabel?.toLowerCase()}</p>
      </div>
    )}



    <!-- Grid de Ejemplos -->
    <div id="examples-container">
      {allLetters.length === 0 ? (
        <div class="text-center py-12">
          <svg class="w-16 h-16 text-base-content/50 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <p class="text-base-content/70 text-lg">No apology letters found for this recipient.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="examples-grid">
          {allLetters.map((letter) => (
            <LetterCard letter={letter} slug={letter.slug} />
          ))}
        </div>
      )}
    </div>



    <!-- Navegación -->
    <div class="mt-12 text-center">
      <a href="/examples" class="btn btn-outline gap-1.5 font-sans">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Back to all sample letters</span>
      </a>
    </div>
  </main>




</Layout>

