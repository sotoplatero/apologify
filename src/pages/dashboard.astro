---
import Layout from "../layouts/Layout.astro";
import SignOutLink from "../components/SignOutLink.svelte";
import PageMenu from "../components/PageMenu.svelte";
import { getPagesByOwner } from "../lib/apologyPages";

export const prerender = false;

// Auth gate: the dashboard is private. Bounce to sign-in and return here after.
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/sign-in?redirect_url=${encodeURIComponent("/dashboard")}`);
}

const allPages = await getPagesByOwner(user.id);
// Unpublished pages are hidden unless asked for (?all=1).
const showAll = Astro.url.searchParams.get("all") === "1";
const hiddenCount = allPages.filter((p) => p.visibility !== "public").length;
const pages = showAll ? allPages : allPages.filter((p) => p.visibility === "public");
// Just published (redirected here from the editor): point at the ⋮ menu to send it.
const justPublished = allPages.find((p) => p.slug === Astro.url.searchParams.get("published"));

// Where the recipient is: not opened → opened → answered.
function status(p: (typeof allPages)[number]) {
  if (p.visibility !== "public") return { label: "Unpublished", cls: "badge-ghost text-base-content/60", title: "Hidden from search and the public list. Publish it from ⋮" };
  if (p.response === "forgiven") return { label: "Forgiven ❤️", cls: "badge-secondary", title: `Answered ${fmtDate(p.respondedAt ?? undefined)}` };
  if (p.response === "not_yet") return { label: "Needs time", cls: "badge-outline", title: `Answered ${fmtDate(p.respondedAt ?? undefined)}` };
  if (p.openedAt) return { label: "Opened", cls: "badge-accent badge-outline", title: `Opened ${fmtDate(p.openedAt)}` };
  return { label: "Not opened yet", cls: "badge-ghost text-base-content/60", title: "They haven't opened the envelope yet" };
}

function fmtDate(d?: string): string {
  if (!d) return "";
  const dt = new Date(d.includes("T") ? d : d.replace(" ", "T") + "Z");
  return isNaN(dt.getTime())
    ? ""
    : dt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

<Layout title="Your dashboard — Apologify" description="Manage your apology pages." noindex={true}>
  <main class="max-w-4xl mx-auto px-4 py-12 min-h-screen flex flex-col">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-bold text-base-content font-display">Your apology pages</h1>
        <p class="text-sm text-base-content/60 mt-1 font-sans flex items-center gap-1.5 flex-wrap">
          <span>Signed in as {user.email}</span>
          <span aria-hidden="true" class="text-base-content/30">·</span>
          <SignOutLink client:load />
        </p>
      </div>
      <div class="flex flex-wrap gap-2 shrink-0">
        {hiddenCount > 0 && (
          <a
            href={showAll ? "/dashboard" : "/dashboard?all=1"}
            class:list={["btn", showAll ? "btn-neutral" : "btn-outline"]}
            aria-pressed={showAll ? "true" : "false"}
          >
            {showAll ? "Hide unpublished" : `Show unpublished (${hiddenCount})`}
          </a>
        )}
        <a href="/generator" class="btn btn-primary">
        <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        New apology page
        </a>
      </div>
    </div>

    {justPublished && (
      <div role="status" class="mb-6 border-l-2 border-primary bg-base-200 px-4 py-3 font-sans text-sm">
        <strong class="font-semibold">It's live.</strong> Send it{justPublished.recipientName ? ` to ${justPublished.recipientName}` : ""} from the ⋮ menu: share, copy the link or download the image.
      </div>
    )}

    {allPages.length === 0 ? (
      <div class="flex-1 flex items-center justify-center">
        <div class="card bg-base-200 border border-base-300 w-full max-w-md">
          <div class="card-body items-center text-center py-16">
            <span class="text-5xl mb-2" role="img" aria-label="Letter">💌</span>
            <h2 class="card-title font-display">No pages yet</h2>
            <p class="text-base-content/60 max-w-sm font-sans">
              Create your first apology page and it'll show up here.
            </p>
            <div class="card-actions mt-4">
              <a href="/generator" class="btn btn-primary">Create one</a>
            </div>
          </div>
        </div>
      </div>
    ) : pages.length === 0 ? (
      <p class="text-center text-base-content/60 font-sans py-16">
        All your pages are unpublished. <a href="/dashboard?all=1" class="underline underline-offset-4 hover:text-base-content">Show them</a>
      </p>
    ) : (
      <div class="grid gap-4">
        {pages.map((p) => {
          const live = p.visibility === "public";
          return (
          <div class:list={[
            "card border transition-shadow",
            live ? "bg-base-100 shadow-sm hover:shadow-md" : "bg-transparent border-dashed",
            justPublished?.slug === p.slug ? "border-primary" : live ? "border-base-300" : "border-base-content/25",
          ]}>
            <div class="card-body flex-row items-center gap-3 p-5">
              <div class:list={["flex-1 min-w-0", !live && "opacity-60"]}>
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="font-semibold text-base-content truncate font-display"><a href={`/sorry/${p.slug}`} data-from-dashboard={p.slug} class="hover:text-primary transition-colors">{p.title}</a></h2>
                  {p.likes > 0 && <span class="badge badge-sm badge-ghost gap-1 font-sans">💛 {p.likes}</span>}
                  {(() => {
                    const s = status(p);
                    return <span class={`badge badge-sm font-sans ${s.cls}`} title={s.title}>{s.label}</span>;
                  })()}
                </div>
                <p class="text-sm text-base-content/60 mt-1 font-sans">
                  To {p.recipientName || p.recipient}{p.createdAt && <span> · {fmtDate(p.createdAt)}</span>}
                </p>
              </div>
              <PageMenu client:load slug={p.slug} isPublic={live} recipientName={p.recipientName} />
            </div>
          </div>
          );
        })}
      </div>
    )}
  </main>
</Layout>

<script is:inline>
  // Opening a letter from here: remember it for this tab, so the letter shows
  // a "← Your pages" link (never put in the URL, which gets copied and shared).
  if (!window.__apFromDash) {
    window.__apFromDash = true;
    document.addEventListener("click", function (e) {
      var a = e.target.closest && e.target.closest("a[data-from-dashboard]");
      if (a) try { sessionStorage.setItem("apologify_from_dashboard", a.dataset.fromDashboard); } catch (_) {}
    }, true);
  }
</script>
