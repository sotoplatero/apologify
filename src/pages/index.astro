---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CallToAction from '../components/CallToAction.astro';
import { articles } from '@/lib/articles';
import { recipients } from '../lib/apologyData';
import { getLetterCount, getToneCounts, getSampleLetters } from '../lib/db';
import { listThemes } from '../lib/themes.js';

export const prerender = false;

const recentArticles = articles.slice(0, 3);
const themes = listThemes();
// Six featured designs for the home "See it live" grid (a diverse spread).
const featuredIds = ["classic", "velvet", "postcard", "editorial", "starry", "cute-duck"];
const featured = featuredIds
  .map((id) => themes.find((t) => t.id === id))
  .filter((t): t is (typeof themes)[number] => Boolean(t));

// Data from the DB
const [letterCount, toneCounts, sampleLetters] = await Promise.all([
  getLetterCount(),
  getToneCounts(),
  getSampleLetters(3)
]);

const uniqueTones = Object.keys(toneCounts);

// Short descriptions for the relationship index
const recipientDescriptions: Record<string, string> = {
  mother: "Mend the bond with heartfelt words",
  father: "Show respect and genuine regret",
  son: "Model accountability as a parent",
  daughter: "Reconnect with love and sincerity",
  wife: "Rebuild trust in your marriage",
  husband: "Express your love and commitment",
  friend: "Save a friendship that matters",
  partner: "Heal your relationship together",
  girlfriend: "Make things right with her",
  boyfriend: "Show him you truly care",
  boss: "Stay professional, stay sincere",
  colleague: "Restore your working relationship",
  client: "Maintain trust and professionalism",
  teacher: "Show respect for their role",
};

function truncateText(text: string, maxLength: number = 200): string {
  if (text.length <= maxLength) return text;
  const truncated = text.slice(0, maxLength);
  const lastSpace = truncated.lastIndexOf(' ');
  return truncated.slice(0, lastSpace) + '…';
}

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const problems = [
  ["A plain text", "Buried in the thread within the hour, and read as barely any effort at all."],
  ["A copied template", "Generic lines they've read a hundred times. They can tell it isn't really you."],
  ["A wall of AI text", "Decent words with nowhere to live — nothing you can actually give them."],
];

const steps = [
  ["Write it", "Tell us who it's for, what happened, and the tone. We turn it into a sincere, personal apology."],
  ["Design it", "Pick a template — letter, cute, formal, vintage and more — and switch it live until it feels right."],
  ["Share the link", "Publish and send them their own page — one they can open, accept, and share back."],
];

const faqs = [
  ["How does the apology website builder work?", "Tell us who the apology is for, what happened, and the tone you want. Our AI writes a sincere, personal apology; you pick a design you love and switch it live; then you share it as its own web page — all in under a minute."],
  ["Who can see my apology?", "By default your page is a private draft — only people you send the link to can open it. It stays private until you decide to publish. Publishing makes it public and findable, and that's always your choice."],
  ["Can I apologize without using my name?", "Yes. Leave the signature off and let the situation speak for itself. The page can be public while staying anonymous — only the person it's really for will recognize the moment."],
  ["Why would I make my apology public?", "Publishing is a way to own it out loud — a clear signal you're not hiding from your mistake. It also helps someone in the same situation find the words. It's always optional."],
  ["Can I choose how the page looks?", "Yes. Pick from designs like Letter, Editorial, Velvet, Night, Postcard, Minimal, Watercolor, Statement and Cute, and switch between them live until it feels right. You can also edit the details and regenerate."],
  ["Is it free?", `Creating and sharing your apology page is free, no credit card required. Choose from ${uniqueTones.length} tones, and publishing publicly just needs a free account. Some premium designs may require an upgrade later.`],
];

// Schema.org structured data
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Apologify",
  "alternateName": "Apologify.com",
  "url": "https://apologify.com",
  "description": "Write a heartfelt apology and turn it into a beautiful, shareable web page in seconds. Free apology website builder with multiple designs."
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Apologify",
  "url": "https://apologify.com",
  "logo": "https://apologify.com/android-chrome-512x512.png",
  "description": "Apology website builder that turns heartfelt apologies into beautiful, shareable pages.",
  "sameAs": []
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(([q, a]) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a }
  }))
};
---

<Layout title="Apology Website Maker — Create a Free Sorry Website & Link" description="Make a cute sorry website for your girlfriend, boyfriend or friend in seconds: write what happened, pick a design, and send them the link. Free, no signup to create." schema={[webSiteSchema, organizationSchema, faqSchema]}>
  <Hero />

  <!-- Why a page: the three usual failures, then what we do instead. -->
  <section class="block split">
    <h2 class="split-title">A text gets ignored. A template sounds fake.</h2>
    <div class="split-body">
      <p class="lede">When it really matters, the medium is the message. Here's what usually goes wrong — and what we do instead.</p>
      <dl class="rows">
        {problems.map(([name, detail]) => (
          <div><dt>{name}</dt><dd>{detail}</dd></div>
        ))}
      </dl>
      <p class="answer">
        Apologify gives you all three at once: words that sound like you, a page that shows you cared, and a link you
        know they opened.
      </p>
    </div>
  </section>

  <!-- Showcase: one apology, every design. -->
  <section id="showcase" class="block showcase">
    <header class="block-head">
      <h2 class="block-title">One apology, {themes.length} ways to send it</h2>
      <p class="block-copy">Write it once, then switch the look until it feels like you — from a handwritten note to a front-page correction.</p>
    </header>
    <ul class="designs">
      {featured.map((t) => (
        <li>
          <a href={`/demo?theme=${t.id}`} class="design">
            <img src={`/designs/${t.id}.jpg`} alt={`${t.label} apology page design`} loading="lazy" width="820" height="1040" />
            <span class="design-name">{t.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="block-more">
      <a href="/designs" class="ap-link">See all {themes.length} designs</a>
    </p>
  </section>

  <!-- How it works -->
  <section class="block">
    <header class="block-head">
      <h2 class="block-title">How it works</h2>
      <p class="block-copy">From sorry to sent in under a minute.</p>
    </header>
    <ol class="steps">
      {steps.map(([title, detail], i) => (
        <li>
          <span class="step-n">{i + 1}</span>
          <h3 class="step-title">{title}</h3>
          <p>{detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Sample letters -->
  <section class="block">
    <header class="block-head">
      <h2 class="block-title">Apology wording to copy &amp; adapt</h2>
      <p class="block-copy">
        Stuck on what to say? Read {letterCount}+ ready-to-copy apology letters for situations like yours — then make your
        own page in a click. New to this? Start with <a href="/apology-letter" class="ap-link">how to write an apology letter</a>.
      </p>
    </header>
    <div class="letters">
      {sampleLetters.map((letter) => (
        <article class="letter">
          <p class="caps letter-meta">{letter.tone} · to a {letter.recipient}</p>
          <h3 class="letter-title">
            <a href={`/examples/${letter.recipient}/${letter.slug}`}>{letter.title || `Apology to ${capitalize(letter.recipient)}`}</a>
          </h3>
          <p class="letter-text">{truncateText(letter.letters[0])}</p>
          <a href={`/examples/${letter.recipient}/${letter.slug}`} class="ap-link letter-link">Read it &amp; make it yours</a>
        </article>
      ))}
    </div>
    <p class="block-more"><a href="/examples" class="ap-link">Browse all sample letters</a></p>
  </section>

  <!-- By relationship: an index of the builder's entry points. -->
  <section class="block split">
    <div>
      <h2 class="split-title">Who do you need to apologize to?</h2>
      <p class="lede">Pick a relationship and the builder opens ready for them — write it, design it, and share the page.</p>
      <a href="/generator" class="ap-link split-alt">Or write a custom apology</a>
    </div>
    <ul class="index">
      {recipients.map((r) => (
        <li>
          <a href={`/generator/${r.value}`}>
            <span class="index-name">Your {r.label.toLowerCase()}</span>
            <span class="index-note">{recipientDescriptions[r.value] || "Generate a personalized apology"}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- FAQ -->
  <section class="block split">
    <div>
      <h2 class="split-title">Questions, answered</h2>
      <p class="lede">Privacy, control, and how it all works.</p>
    </div>
    <div class="faq">
      {faqs.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Guides -->
  <section class="block">
    <header class="block-head">
      <h2 class="block-title">Learn how to apologize the right way</h2>
      <p class="block-copy">Expert advice on crafting apologies that actually repair relationships.</p>
    </header>
    <div class="guides">
      {recentArticles.map((article) => (
        <a href={`/articles/${article.slug}`} class="guide">
          {article.data.image && (
            <img src={article.data.image} alt="" width="800" height="533" loading="lazy" />
          )}
          <span class="guide-title">{article.data.title}</span>
        </a>
      ))}
    </div>
    <p class="block-more"><a href="/articles" class="ap-link">View all articles</a></p>
  </section>

  <CallToAction />
</Layout>

<style>
  .block { margin-top: clamp(5rem, 10vw, 8rem); padding-top: 1.5rem; border-top: 1px solid var(--ap-ink); }
  .block-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 1rem 3rem; align-items: end; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .block-title, .split-title {
    margin: 0;
    font-family: 'Spectral', Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--ap-ink);
    text-wrap: balance;
  }
  .block-copy, .lede {
    margin: 0;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ap-body);
    text-wrap: pretty;
  }
  .block-more { margin: 2.5rem 0 0; font-family: 'Jost', system-ui, sans-serif; font-size: 0.95rem; }

  /* Split: a heading column and a reading column, like a magazine department. */
  .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2.5rem clamp(2rem, 5vw, 5rem); }
  .split .lede { margin-top: 1.25rem; max-width: 30rem; }
  .split-body .lede { margin-top: 0; }
  .split-alt { display: inline-block; margin-top: 1.5rem; font-family: 'Jost', system-ui, sans-serif; font-size: 0.95rem; }
  .split-title { font-style: italic; }

  .rows { margin: 2rem 0 0; }
  .rows div { display: grid; grid-template-columns: 12rem 1fr; gap: 1.5rem; padding: 1.15rem 0; border-top: 1px solid var(--ap-rule); }
  .rows div:last-child { border-bottom: 1px solid var(--ap-rule); }
  .rows dt { font-family: 'Spectral', Georgia, serif; font-size: 1.25rem; letter-spacing: -0.01em; color: var(--ap-ink); }
  .rows dd { margin: 0; font-family: 'Jost', system-ui, sans-serif; font-size: 0.95rem; line-height: 1.6; color: var(--ap-body); }
  .answer {
    margin: 2rem 0 0;
    font-family: 'Spectral', Georgia, serif;
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ap-ink);
    text-wrap: pretty;
  }

  .designs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem clamp(1.25rem, 3vw, 3rem); }
  .design { display: block; }
  .design img { width: 100%; height: auto; display: block; background: var(--ap-soft); transition: opacity 0.4s var(--ap-ease); }
  .design:hover img { opacity: 0.85; }
  .design-name { display: block; margin-top: 1rem; font-family: 'Spectral', Georgia, serif; font-size: 1.4rem; letter-spacing: -0.015em; color: var(--ap-ink); }
  .design:hover .design-name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .steps li { padding: 0 clamp(1.25rem, 3vw, 2.5rem); border-left: 1px solid var(--ap-rule); }
  .steps li:first-child { padding-left: 0; border-left: 0; }
  .step-n { font-family: 'Spectral', Georgia, serif; font-size: 3.25rem; line-height: 1; color: var(--ap-red); }
  .step-title { margin: 1.25rem 0 0.6rem; font-family: 'Spectral', Georgia, serif; font-weight: 400; font-size: 1.6rem; letter-spacing: -0.015em; color: var(--ap-ink); }
  .steps p { margin: 0; font-family: 'Jost', system-ui, sans-serif; font-size: 0.98rem; line-height: 1.65; color: var(--ap-body); max-width: 30ch; }

  .letters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem clamp(1.5rem, 3vw, 3rem); }
  .letter { display: flex; flex-direction: column; }
  .letter-meta { margin: 0; color: var(--ap-mute); }
  .letter-title { margin: 0.9rem 0 0; font-family: 'Spectral', Georgia, serif; font-weight: 400; font-size: 1.5rem; line-height: 1.15; letter-spacing: -0.015em; color: var(--ap-ink); text-wrap: balance; }
  .letter-title a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .letter-text {
    margin: 1rem 0 1.5rem;
    font-family: 'Spectral', Georgia, serif;
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ap-body);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .letter-link { margin-top: auto; font-family: 'Jost', system-ui, sans-serif; font-size: 0.9rem; align-self: flex-start; }

  .index { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; }
  .index li { border-top: 1px solid var(--ap-rule); }
  .index a { display: flex; flex-direction: column; gap: 0.2rem; padding: 1rem 0; }
  .index-name { font-family: 'Spectral', Georgia, serif; font-size: 1.3rem; letter-spacing: -0.01em; color: var(--ap-ink); transition: color 0.2s; }
  .index-note { font-family: 'Jost', system-ui, sans-serif; font-size: 0.85rem; color: var(--ap-mute); }
  .index a:hover .index-name { color: var(--ap-red); }

  .faq details { border-top: 1px solid var(--ap-rule); }
  .faq details:last-child { border-bottom: 1px solid var(--ap-rule); }
  .faq summary {
    position: relative;
    list-style: none;
    padding: 1.25rem 2.5rem 1.25rem 0;
    font-family: 'Spectral', Georgia, serif;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    color: var(--ap-ink);
    cursor: pointer;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::before,
  .faq summary::after {
    content: '';
    position: absolute;
    right: 0.25rem;
    top: 50%;
    width: 0.9rem;
    height: 1px;
    background: var(--ap-ink);
    transition: transform 0.3s var(--ap-ease);
  }
  .faq summary::after { transform: rotate(90deg); }
  .faq details[open] summary::after { transform: rotate(0deg); }
  .faq details p { margin: 0 0 1.5rem; max-width: 62ch; font-family: 'Jost', system-ui, sans-serif; font-size: 0.98rem; line-height: 1.7; color: var(--ap-body); }

  .guides { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem clamp(1.25rem, 3vw, 3rem); }
  .guide { display: flex; flex-direction: column; }
  .guide img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block; background: var(--ap-soft); transition: opacity 0.4s var(--ap-ease); }
  .guide:hover img { opacity: 0.85; }
  .guide-title { margin-top: 1rem; font-family: 'Spectral', Georgia, serif; font-size: 1.35rem; line-height: 1.18; letter-spacing: -0.015em; color: var(--ap-ink); text-wrap: balance; }
  .guide:hover .guide-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }

  @media (max-width: 860px) {
    .block-head, .split { grid-template-columns: 1fr; }
    .designs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1rem; }
    .design-name { font-size: 1.15rem; }
    .steps, .letters, .guides { grid-template-columns: 1fr; gap: 2.5rem; }
    .steps li { padding: 0; border-left: 0; }
    .rows div { grid-template-columns: 1fr; gap: 0.35rem; }
    .index { grid-template-columns: 1fr; }
  }
</style>
