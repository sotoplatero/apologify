---
import type { Letter } from '../lib/db';

interface Props {
  letter: Letter;
  slug: string;
}

const { letter, slug } = Astro.props;

function truncateText(text: string, maxLength: number): string {
  if (text.length <= maxLength) return text;
  return text.slice(0, maxLength) + '…';
}
---

<article class="example-card" data-recipient={letter.recipient} data-tone={letter.tone}>
  <a href={`/examples/${letter.recipient}/${slug}`}>
    <p class="meta">{letter.tone} · to a {letter.recipient}</p>
    <h2 class="title">{letter.title || letter.context}</h2>
    <p class="text">{truncateText(letter.letters[0], 150)}</p>
    <p class="meta foot">{letter.letters.length} {letter.letters.length === 1 ? 'example' : 'examples'}</p>
  </a>
</article>

<style>
  .example-card { border-top: 1px solid #e0d8c8; }
  a { display: flex; flex-direction: column; height: 100%; padding: 1.5rem 0 2.25rem; }
  .meta {
    margin: 0;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6b6157;
  }
  .title {
    margin: 0.8rem 0 0;
    font-family: 'Spectral', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: #241f1a;
    text-wrap: balance;
    transition: color 0.2s;
  }
  a:hover .title { color: #c1272d; }
  .text {
    margin: 0.9rem 0 1.25rem;
    font-family: 'Spectral', Georgia, serif;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.6;
    color: #3a332c;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot { margin-top: auto; }
</style>
