---
import { tones, recipients } from "../lib/apologyData.js";

const currentYear = new Date().getFullYear();

const topTones = tones.filter((t) => t.value !== "other").slice(0, 6);

const site = [
  { href: "/generator", label: "Apology builder" },
  { href: "/designs", label: "Designs" },
  { href: "/articles/how-to-write-an-apology-letter", label: "How to write an apology letter" },
  { href: "/sorry-card", label: "Sorry cards" },
  { href: "/news", label: "Apology News" },
  { href: "/research/why-people-apologize", label: "Apology study" },
  { href: "/examples", label: "Sample letters" },
  { href: "/articles", label: "Articles" },
  { href: "/about", label: "About us" },
  { href: "/contact", label: "Contact" },
];
---

<footer class="ap-foot">
  <div class="ap-foot-in">
    <div class="ap-foot-brand">
      <a href="/" class="ap-foot-mark"><img src="/seal.svg" alt="" width="40" height="40" /> Apologify</a>
      <p>Turn a heartfelt apology into a beautiful, shareable web page. Free to create: pick a design and send the link.</p>
    </div>

    <nav class="ap-foot-col" aria-labelledby="foot-site">
      <h2 id="foot-site">Apologify</h2>
      <ul>{site.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav class="ap-foot-col" aria-labelledby="foot-gen">
      <h2 id="foot-gen">Generators</h2>
      <ul>{recipients.map((r) => <li><a href={`/generator/${r.value}`}>Sorry to {r.label.toLowerCase()}</a></li>)}</ul>
    </nav>

    <nav class="ap-foot-col" aria-labelledby="foot-dir">
      <h2 id="foot-dir">Directory</h2>
      <ul>{recipients.map((r) => <li><a href={`/examples?recipient=${r.value}`}>{r.label} examples</a></li>)}</ul>
    </nav>

    <nav class="ap-foot-col" aria-labelledby="foot-tones">
      <h2 id="foot-tones">Tones</h2>
      <ul>{topTones.map((t) => <li><a href={`/examples?tone=${t.value}`}>{t.label} apologies</a></li>)}</ul>
    </nav>
  </div>

  <div class="ap-foot-base">
    <p>&copy; {currentYear} Apologify</p>
    <p>Made to help mend relationships</p>
  </div>
</footer>

<style>
  .ap-foot {
    margin-top: clamp(5rem, 10vw, 8rem);
    padding: 0 1rem;
    font-family: 'Jost', system-ui, sans-serif;
    color: #241f1a;
  }
  .ap-foot-in,
  .ap-foot-base {
    max-width: 78rem;
    margin: 0 auto;
  }
  .ap-foot-in {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(4, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    padding: 3rem 0 3.5rem;
    border-top: 1px solid #241f1a;
  }
  .ap-foot-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: 'Spectral', Georgia, serif;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
  }
  .ap-foot-brand p {
    margin: 1rem 0 0;
    max-width: 22rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #6b6157;
  }
  .ap-foot-col h2 {
    margin: 0 0 1.1rem;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ap-foot-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .ap-foot-col a { font-size: 0.88rem; color: #3a332c; transition: color 0.2s; }
  .ap-foot-col a:hover { color: #c1272d; }
  .ap-foot-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding: 1.25rem 0 2rem;
    border-top: 1px solid #e0d8c8;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6b6157;
  }
  .ap-foot-base p { margin: 0; }

  @media (max-width: 960px) {
    .ap-foot-in { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ap-foot-brand { grid-column: 1 / -1; }
  }
</style>
