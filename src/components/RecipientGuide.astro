---
import type { RecipientGuide } from "../lib/recipientGuides";
import { recipients } from "../lib/apologyData.js";

interface Props {
  guide: RecipientGuide;
  recipient: string;
  count: number;
}

const { guide, recipient, count } = Astro.props;
const builderHref = recipients.some((r) => r.value === recipient) ? `/generator/${recipient}` : "/generator";
---

<div class="rg">
  <header class="rg-hero">
    <h1>{guide.h1}</h1>
    <p class="rg-lede">{guide.intro}</p>
    <nav class="rg-toc caps" aria-label="On this page">
      <a href="#how">How to write it</a>
      <a href="#samples">Sample letters</a>
      <a href="#examples">{count} more examples</a>
      <a href="#faq">FAQ</a>
    </nav>
  </header>

  <section class="rg-block" id="how">
    <h2 class="rg-h2">How to write it</h2>
    <ol class="rg-steps">
      {guide.steps.map((s, i) => (
        <li>
          <span class="rg-n" aria-hidden="true">{i + 1}</span>
          <div>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="rg-block" id="samples">
    <h2 class="rg-h2">Sample letters</h2>
    <div class="rg-samples">
      {guide.samples.map((s) => (
        <article>
          <h3 class="rg-sit">{s.situation}</h3>
          <div class="rg-letter">{s.body.map((line) => <p>{line}</p>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="rg-block rg-split">
    <h2 class="rg-h2">Before you send it</h2>
    <ul class="rg-tips">{guide.tips.map((t) => <li>{t}</li>)}</ul>
  </section>

  <section class="rg-block rg-split rg-cta">
    <h2 class="rg-h2">Want help with yours?</h2>
    <div>
      <p>
        Tell Apologify what happened and it drafts an apology about that exact moment — you edit it, then send it as a
        link or print it. For the general format, see <a href="/apology-letter" class="ap-link">how to write an apology letter</a>.
      </p>
      <a href={builderHref} class="rg-btn">Write my letter</a>
    </div>
  </section>

  <section class="rg-block rg-split" id="faq">
    <h2 class="rg-h2">Questions</h2>
    <div>
      {guide.faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <h2 class="rg-h2 rg-grid-title" id="examples">{count} real examples</h2>
</div>

<style>
  .rg { color: var(--ap-ink); max-width: 72rem; margin: 0 auto; }
  .rg-hero { padding: clamp(1rem, 4vw, 3rem) 0 0; max-width: 50rem; }
  .rg-hero h1 { margin: 0; font-weight: 300; font-size: clamp(2.5rem, 6vw, 5rem); line-height: 1; letter-spacing: -0.03em; text-wrap: balance; }
  .rg-lede { margin: 1.5rem 0 0; max-width: 40rem; font-family: 'Spectral', Georgia, serif; font-size: 1.25rem; line-height: 1.55; color: var(--ap-body); text-wrap: pretty; }
  .rg-toc { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; margin-top: 2rem; }
  .rg-toc a { color: var(--ap-ink); }
  .rg-toc a:hover { color: var(--ap-red); }

  .rg-block { margin-top: clamp(3.5rem, 7vw, 5.5rem); padding-top: 1.5rem; border-top: 1px solid var(--ap-ink); scroll-margin-top: 5rem; }
  .rg-h2 { margin: 0 0 2rem; font-size: clamp(1.9rem, 3.8vw, 3rem); line-height: 1.05; letter-spacing: -0.025em; text-wrap: balance; }
  .rg-split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 1rem clamp(2rem, 5vw, 5rem); }

  .rg-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .rg-steps li { padding: 0 1.25rem; border-left: 1px solid var(--ap-rule); }
  .rg-steps li:first-child { padding-left: 0; border-left: 0; }
  .rg-n { font-family: 'Spectral', Georgia, serif; font-weight: 300; font-size: 2.75rem; line-height: 1; color: var(--ap-red); }
  .rg-steps h3 { margin: 1rem 0 0.5rem; font-size: 1.3rem; line-height: 1.2; }
  .rg-steps p { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--ap-body); }

  .rg-samples { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem clamp(1.5rem, 4vw, 4rem); }
  .rg-sit { margin: 0 0 1rem; font-size: 1.45rem; line-height: 1.2; }
  .rg-letter { padding-left: 1.25rem; border-left: 2px solid var(--ap-red); }
  .rg-letter p { margin: 0 0 0.85rem; font-family: 'Spectral', Georgia, serif; font-size: 1.05rem; line-height: 1.6; color: var(--ap-body); }
  .rg-letter p:last-child { margin-bottom: 0; }

  .rg-tips { list-style: none; margin: 0; padding: 0; }
  .rg-tips li { padding: 1rem 0; border-top: 1px solid var(--ap-rule); font-family: 'Spectral', Georgia, serif; font-size: 1.15rem; line-height: 1.5; }
  .rg-tips li:first-child { border-top: 0; padding-top: 0; }

  .rg-cta p { margin: 0 0 1.75rem; max-width: 36rem; font-family: 'Spectral', Georgia, serif; font-size: 1.15rem; line-height: 1.6; color: var(--ap-body); }
  .rg-btn {
    display: inline-block;
    padding: 1.05rem 1.9rem;
    background: var(--ap-red);
    color: #faf7f1;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: background-color 0.25s;
  }
  .rg-btn:hover { background: var(--ap-ink); }

  .rg details { border-top: 1px solid var(--ap-rule); }
  .rg details:last-child { border-bottom: 1px solid var(--ap-rule); }
  .rg summary { position: relative; list-style: none; padding: 1.1rem 2.5rem 1.1rem 0; font-family: 'Spectral', Georgia, serif; font-size: 1.2rem; cursor: pointer; }
  .rg summary::-webkit-details-marker { display: none; }
  .rg summary::before,
  .rg summary::after { content: ''; position: absolute; right: 0.25rem; top: 50%; width: 0.9rem; height: 1px; background: var(--ap-ink); transition: transform 0.3s var(--ap-ease); }
  .rg summary::after { transform: rotate(90deg); }
  .rg details[open] summary::after { transform: rotate(0deg); }
  .rg details p { margin: 0 0 1.25rem; max-width: 62ch; font-size: 0.98rem; line-height: 1.7; color: var(--ap-body); }

  .rg-grid-title { margin-top: clamp(3.5rem, 7vw, 5.5rem); padding-top: 1.5rem; border-top: 1px solid var(--ap-ink); scroll-margin-top: 5rem; }

  @media (max-width: 1000px) {
    .rg-steps { grid-template-columns: 1fr; gap: 1.5rem; }
    .rg-steps li { padding: 0; border-left: 0; display: grid; grid-template-columns: 2.75rem 1fr; }
    .rg-steps h3 { margin-top: 0.2rem; }
    .rg-n { font-size: 2.1rem; }
  }
  @media (max-width: 800px) {
    .rg-split, .rg-samples { grid-template-columns: 1fr; }
  }
</style>
