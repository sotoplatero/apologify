---
// The cover shown over a live apology page: the Apologify seal, the recipient's
// name and "Open it". Opening presses the seal, the cover's contents step back
// and the whole sheet lifts away, revealing the letter underneath.
// Shown once per browser session; the first open is recorded so the sender is
// told it was opened.
interface Props {
  slug: string;
  recipientName?: string | null;
  senderName?: string | null;
}
const { slug, recipientName, senderName } = Astro.props;
const name = recipientName?.trim() || "you";
const from = senderName?.trim();
---

<div id="envelope-reveal" data-slug={slug} role="dialog" aria-modal="true" aria-labelledby="envelope-title">
  <div class="er-inner">
    <img class="er-seal" src="/seal.svg" alt="" width="64" height="64" />
    <p class="er-for" id="envelope-title"><span>For</span> {name}</p>
    {from && <p class="er-from">from {from}</p>}
    <button type="button" class="er-open">Open it</button>
  </div>
</div>
<noscript><style>#envelope-reveal { display: none !important; }</style></noscript>

<script is:inline define:vars={{ slug }}>
  // Everything needed to open the cover lives here, inline, so it works even
  // if the page's bundled JS fails to load (stale cache, blocker, slow network).
  (function () {
    var root = document.getElementById("envelope-reveal");
    if (!root) return;
    var key = "apologify_opened_" + slug;
    try {
      if (sessionStorage.getItem(key) === "1") { root.remove(); return; }
    } catch (_) {}
    document.documentElement.classList.add("er-locked");

    var button = root.querySelector(".er-open");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    function open() {
      if (root.classList.contains("is-opening")) return;
      root.classList.add("is-opening");
      try { sessionStorage.setItem(key, "1"); } catch (_) {}
      window.dispatchEvent(new CustomEvent("apology:opened", { detail: { slug: slug } }));
      window.setTimeout(function () {
        document.documentElement.classList.remove("er-locked");
        root.remove();
      }, reduce ? 260 : 1150);
    }
    button.addEventListener("click", open);
    root.addEventListener("keydown", function (e) {
      if (e.key === "Escape") open();
      if (e.key === "Tab") { e.preventDefault(); button.focus(); } // single control: keep focus here
    });
  })();
</script>

<script>
  // Only records the first open (so the sender is told); opening never waits on it.
  import { actions } from "astro:actions";
  window.addEventListener("apology:opened", (e) => {
    const slug = (e as CustomEvent<{ slug: string }>).detail.slug;
    actions.markApologyOpened({ slug }).catch(() => {});
  });
</script>

<style is:global>
  html.er-locked, html.er-locked body { overflow: hidden; }

  #envelope-reveal {
    --ink: #241F1A;
    --ink-soft: #6E655A;
    --ink-blue: #2C4A6E;
    --red: #C1272D;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    padding: 32px 20px;
    background:
      radial-gradient(ellipse 70% 55% at 50% 45%, #FBF8F2 0%, rgba(251, 248, 242, 0) 72%),
      #F5F1E8;
    color: var(--ink);
    /* the sheet's lower edge casts a shadow as it lifts away */
    box-shadow: 0 24px 60px -10px rgba(36, 31, 26, 0);
    transition:
      transform 0.85s cubic-bezier(0.7, 0, 0.2, 1) 0.28s,
      box-shadow 0.4s ease 0.28s;
  }
  #envelope-reveal ::selection { background: rgba(193, 39, 45, 0.18); }

  #envelope-reveal .er-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 22rem;
    transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  #envelope-reveal .er-seal {
    width: 64px;
    height: 64px;
    filter: drop-shadow(0 3px 5px rgba(110, 16, 20, 0.25));
    transition: transform 0.25s var(--ease-out);
    animation: er-rise 0.8s var(--ease-out) backwards;
  }

  #envelope-reveal .er-for {
    margin: 28px 0 0;
    font-family: "Dancing Script", cursive;
    font-weight: 600;
    font-size: clamp(48px, 13vw, 76px);
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--ink-blue);
    overflow-wrap: anywhere;
    text-wrap: balance;
    animation: er-rise 0.8s var(--ease-out) 0.12s backwards;
  }
  #envelope-reveal .er-for span {
    display: block;
    margin-bottom: 4px;
    font-family: "Jost", system-ui, sans-serif;
    font-weight: 400;
    font-size: 15px;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  #envelope-reveal .er-from {
    margin: 14px 0 0;
    font-family: "Dancing Script", cursive;
    font-size: 24px;
    line-height: 1.2;
    color: var(--ink);
    overflow-wrap: anywhere;
    animation: er-rise 0.8s var(--ease-out) 0.2s backwards;
  }

  #envelope-reveal .er-open {
    margin-top: 40px;
    font-family: "Jost", system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #FBF8F2;
    background: var(--red);
    border: 0;
    border-radius: 2px;
    padding: 15px 40px;
    min-height: 50px;
    cursor: pointer;
    box-shadow: 0 1px 0 rgba(110, 16, 20, 0.4), 0 10px 22px -10px rgba(193, 39, 45, 0.55);
    transition: transform 0.2s var(--ease-out), background-color 0.2s;
    animation: er-rise 0.8s var(--ease-out) 0.32s backwards;
  }
  #envelope-reveal .er-open:hover { background: #AD2228; transform: translateY(-1px); }
  #envelope-reveal .er-open:active { transform: translateY(1px); }
  #envelope-reveal .er-open:focus-visible { outline: 2px solid var(--ink-blue); outline-offset: 4px; }

  /* Opening: the seal is pressed, the words step back, the sheet lifts away */
  #envelope-reveal.is-opening .er-seal { transform: scale(0.88); }
  #envelope-reveal.is-opening .er-inner { opacity: 0; transform: translateY(-12px); transition-delay: 0.08s; }
  #envelope-reveal.is-opening {
    transform: translateY(-100%);
    box-shadow: 0 24px 60px -10px rgba(36, 31, 26, 0.22);
    pointer-events: none;
  }

  @keyframes er-rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    #envelope-reveal .er-seal,
    #envelope-reveal .er-for,
    #envelope-reveal .er-from,
    #envelope-reveal .er-open { animation: none; }
    #envelope-reveal { transition: opacity 0.25s linear; }
    #envelope-reveal.is-opening { transform: none; opacity: 0; box-shadow: none; }
    #envelope-reveal.is-opening .er-inner { transform: none; }
  }
</style>
