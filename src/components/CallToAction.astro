---
import { listThemes } from "../lib/themes.js";
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Don’t just say it. Show it.",
  description = "Turn your apology into a page they’ll actually open — written for you, designed by you, shared in one link."
} = Astro.props;

const designCount = listThemes().length;
---

<section class="ap-cta">
  <h2 class="ap-cta-title">{title}</h2>
  <p class="ap-cta-copy">{description}</p>
  <a href="/generator" class="ap-cta-btn">Make my apology page</a>
  <p class="ap-cta-facts">Free to create · {designCount} designs · One link to send</p>
</section>

<style>
  .ap-cta {
    margin: clamp(5rem, 10vw, 8rem) auto 0;
    max-width: 46rem;
    padding: clamp(3rem, 6vw, 4.5rem) 0 0;
    border-top: 1px solid #e0d8c8;
    text-align: center;
  }
  .ap-cta-title {
    margin: 0;
    font-family: 'Spectral', Georgia, serif;
    font-size: clamp(2.2rem, 5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: #241f1a;
    text-wrap: balance;
  }
  .ap-cta-copy {
    margin: 1.25rem auto 2.25rem;
    max-width: 34rem;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 1.02rem;
    line-height: 1.65;
    color: #3a332c;
    text-wrap: pretty;
  }
  .ap-cta-btn {
    display: inline-block;
    padding: 1.05rem 2rem;
    background: #c1272d;
    color: #faf7f1;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: background-color 0.25s;
  }
  .ap-cta-btn:hover { background: #241f1a; }
  .ap-cta-facts {
    margin: 1.25rem 0 0;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6b6157;
  }
</style>
