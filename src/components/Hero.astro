---
// Hero: the offer on the left; on the right the same apology changing designs,
// so the product shows itself instead of being described.
import { listThemes } from "../lib/themes.js";
const themes = listThemes();
const designCount = themes.length;
const cycle = ["classic", "velvet", "editorial", "postcard", "starry"]
  .map((id) => themes.find((t) => t.id === id))
  .filter((t): t is (typeof themes)[number] => Boolean(t));
---

<section class="home-hero">
  <div class="hero-text">
    <h1 class="hero-title">Turn your apology into a page worth opening.</h1>
    <p class="hero-dek">
      Tell us what happened and pick a design you love. We write a sincere, personal apology and turn it into a
      beautiful web page — with a link they can read, accept, and keep.
    </p>
    <div class="hero-actions">
      <a href="/generator" class="hero-btn">Make my apology page</a>
      <a href="#showcase" class="ap-link hero-alt">See the designs</a>
    </div>
    <p class="caps hero-facts">Free to create · {designCount} designs · One link to send</p>
  </div>

  <figure class="hero-stage" style={`--n: ${cycle.length}`}>
    <div class="hero-frames">
      {cycle.map((t, i) => (
        <img
          src={`/designs/${t.id}.jpg`}
          alt={i === 0 ? `The same apology page in the ${t.label} design` : ''}
          width="820"
          height="1040"
          style={`--i: ${i}`}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
      ))}
    </div>
    <figcaption class="caps hero-cap">
      <span>One apology, in</span>
      <span class="hero-names">
        {cycle.map((t, i) => <span style={`--i: ${i}`}>{t.label}</span>)}
      </span>
    </figcaption>
  </figure>
</section>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1.25rem, 3vw, 3rem);
    align-items: center;
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 7rem);
  }
  .hero-text { grid-column: 1 / span 6; }
  .hero-title {
    margin: 0;
    font-family: 'Spectral', Georgia, serif;
    font-weight: 300;
    font-size: clamp(2.75rem, 6vw, 5.25rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ap-ink);
    text-wrap: balance;
  }
  .hero-dek {
    margin: 1.75rem 0 0;
    max-width: 32rem;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--ap-body);
    text-wrap: pretty;
  }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem; margin-top: 2.25rem; }
  .hero-btn {
    padding: 1.05rem 1.9rem;
    background: var(--ap-red);
    color: #faf7f1;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: background-color 0.25s;
  }
  .hero-btn:hover { background: var(--ap-ink); }
  .hero-alt { font-family: 'Jost', system-ui, sans-serif; font-size: 0.95rem; color: var(--ap-ink); }
  .hero-facts { margin: 2rem 0 0; color: var(--ap-mute); }

  /* The same apology, one design after another: each frame unveils over the last. */
  .hero-stage { grid-column: 8 / span 5; margin: 0; }
  .hero-frames { position: relative; aspect-ratio: 820 / 1040; background: var(--ap-soft); }
  .hero-frames img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-frame calc(var(--n) * 3.2s) linear infinite both;
    animation-delay: calc(var(--i) * 3.2s - 3.2s);
  }
  /* Each frame owns a fifth of the loop: it unveils from the top over the
     previous one, holds, then stays underneath until the next has unveiled. */
  @keyframes hero-frame {
    0% { clip-path: inset(0 0 100% 0); opacity: 1; z-index: 2; animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }
    5%, 20% { clip-path: inset(0 0 0 0); opacity: 1; z-index: 2; }
    20.01%, 25% { clip-path: inset(0 0 0 0); opacity: 1; z-index: 1; }
    25.01%, 100% { clip-path: inset(0 0 0 0); opacity: 0; z-index: 0; }
  }
  .hero-cap { display: flex; gap: 0.5em; margin-top: 1rem; color: var(--ap-mute); }
  .hero-names { position: relative; flex: 1; color: var(--ap-ink); }
  .hero-names span {
    position: absolute;
    left: 0;
    opacity: 0;
    animation: hero-name calc(var(--n) * 3.2s) linear infinite;
    animation-delay: calc(var(--i) * 3.2s - 3.2s);
  }
  @keyframes hero-name {
    0%, 2% { opacity: 0; }
    5%, 19% { opacity: 1; }
    21%, 100% { opacity: 0; }
  }

  @media (max-width: 860px) {
    .home-hero { display: block; padding-top: 2.5rem; }
    .hero-stage { max-width: 22rem; margin: 3rem auto 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-frames img, .hero-names span { animation: none; }
    .hero-frames img:not(:first-child), .hero-names span:not(:first-child) { display: none; }
    .hero-names span:first-child { opacity: 1; }
  }
</style>
