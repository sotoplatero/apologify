---
// Minimal: a white page and nothing else — large light type, generous space,
// one hairline. The words carry it.
import ApologyActions from "../ApologyActions.svelte";
const { title, heading, paragraphs, senderName, slug, acceptedAt, preview } = Astro.props;
---
<main class="mn">
  <div class="mn-page">
    <h1 class="mn-title">{title}</h1>
    <span class="mn-rule" aria-hidden="true"></span>

    {heading && <p class="mn-heading">{heading}</p>}
    <div class="mn-body">
      {paragraphs.map((p: string) => <p set:html={p} />)}
    </div>
    {senderName && <p class="mn-sign">— {senderName}</p>}

    <div class="mn-actions">
      <ApologyActions client:load slug={slug} acceptedAt={acceptedAt} preview={preview}
        acceptLabel="Like this"
        primaryClass="mn-btn mn-btn-solid"
        secondaryClass="mn-btn mn-btn-line"
        mutedClass="mn-muted" />
    </div>
    <a href="/generator" class="mn-made">Made on apologify.com — write your own</a>
  </div>
</main>

<style>
  .mn {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(3rem, 10vw, 8rem) 1.5rem 3rem;
    background: #ffffff;
    color: #161616;
    font-family: 'Spectral', Georgia, serif;
  }
  .mn-page { width: 100%; max-width: 36rem; animation: mn-rise 1.3s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both; }
  .mn-title { margin: 0; font-weight: 300; font-size: clamp(2.4rem, 7vw, 3.8rem); line-height: 1.06; letter-spacing: -0.025em; text-wrap: balance; }
  .mn-rule { display: block; width: 2.5rem; height: 1px; margin: 2.5rem 0; background: #161616; }
  .mn-heading { margin: 0 0 1.25rem; font-size: 1.25rem; color: #161616; }
  .mn-body { font-size: clamp(1.08rem, 2.2vw, 1.2rem); line-height: 1.8; font-weight: 300; color: #2d2d2d; }
  .mn-body :global(p) { margin: 0 0 1.25em; }
  .mn-body :global(strong) { font-weight: 500; color: #161616; }
  .mn-sign { margin: 2.25rem 0 0; font-size: 1.25rem; font-style: italic; color: #161616; }

  .mn-actions { margin-top: 3.5rem; }
  /* Left-aligned page: align the shared action row to the text column. */
  .mn-actions :global(div) { justify-content: flex-start; align-items: flex-start; text-align: left; }
  .mn-actions :global(.mn-btn) {
    padding: 0.95rem 1.6rem;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: background-color 0.25s, color 0.25s;
  }
  .mn-actions :global(.mn-btn-solid) { background: #161616; color: #fff; }
  .mn-actions :global(.mn-btn-solid:hover) { background: #000; }
  .mn-actions :global(.mn-btn-line) { border: 1px solid #d4d4d4; color: #161616; }
  .mn-actions :global(.mn-btn-line:hover) { border-color: #161616; }
  .mn-actions :global(.mn-muted) { font-family: 'Jost', system-ui, sans-serif; font-size: 0.85rem; color: #6f6f6f; }
  .mn-made { display: block; margin-top: 3.5rem; font-family: 'Jost', system-ui, sans-serif; font-size: 0.64rem; letter-spacing: 0.22em; text-transform: uppercase; color: #8a8a8a; }
  .mn-made:hover { color: #161616; }
  @keyframes mn-rise { from { opacity: 0; transform: translateY(18px); } }
  @media (prefers-reduced-motion: reduce) { .mn-page { animation: none; } }
</style>
